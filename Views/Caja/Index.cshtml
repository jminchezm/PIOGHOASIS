@model PIOGHOASIS.Models.ViewModels.CajaIndexVM
@{
    Layout = null;

    var q = Context.Request.Query;
    var qCodigo = q["Codigo"].ToString();
    var qUsuario = q["Usuario"].ToString();
    var qEstado = q.ContainsKey("EstadoCajaID") ? q["EstadoCajaID"].ToString() : ""; // "" = todos

    // formatea fechas para el input date (yyyy-MM-dd)
    string toDateVal(string s)
    {
        if (DateTime.TryParse(s, out var d)) return d.ToString("yyyy-MM-dd");
        return "";
    }
    var qDesde = toDateVal(q["FechaDesde"]);
    var qHasta = toDateVal(q["FechaHasta"]);
}

<style>
    /* === Mismo look que Puestos (clase renombrada) === */
    .caja-ui {
        position: relative;
        margin-top: 0;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        background: linear-gradient(rgba(255,255,255,.30), rgba(255,255,255,.30)), url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        padding: 30px;
    }

        .caja-ui .card-filtros {
            background: rgba(255,255,255,.85);
            box-shadow: 0 6px 22px rgba(0,0,0,.08);
            border: 1px solid rgba(0,0,0,.06);
            border-radius: .75rem;
        }

        .caja-ui .tt {
            font-size: clamp(1.25rem,1.8vw,1.75rem);
            font-weight: 800;
            color: #1f2a37;
        }

        .caja-ui .btn-nuevo {
            background: #f0a100;
            border: none;
            color: #222;
            font-weight: 800;
            box-shadow: 0 10px 22px rgba(240,161,0,.35);
        }

            .caja-ui .btn-nuevo:hover {
                background: #db9400;
            }

        .caja-ui table {
            background: #fff
        }

        .caja-ui thead th {
            background: #f3c259;
            color: #222;
            border-bottom: 2px solid #d7a536;
            vertical-align: middle;
        }

        .caja-ui tbody td {
            vertical-align: middle;
        }

        .caja-ui .pill {
            display: inline-block;
            padding: .15rem .5rem;
            border-radius: 999px;
            font-size: .84rem;
            font-weight: 700;
        }

        .caja-ui .pill-ok {
            background: #e8f7e9;
            color: #16803d;
            border: 1px solid #bfe8c2;
        }

        .caja-ui .pill-off {
            background: #fff0f0;
            color: #b42318;
            border: 1px solid #f5c2c7;
        }

        .caja-ui .btn-icon {
            --bs-btn-padding-y: .25rem;
            --bs-btn-padding-x: .45rem;
            --bs-btn-border-radius: .35rem;
        }

        .caja-ui .pagination .page-link {
            border: none;
        }

        .caja-ui .pagination .active > .page-link {
            background: #f0a100;
            color: #222;
        }

        .caja-ui .clearable {
            position: relative;
        }

            .caja-ui .clearable .btn-clear {
                position: absolute;
                right: .35rem;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #6c757d;
                display: none;
            }

            .caja-ui .clearable input:not(:placeholder-shown) + .btn-clear {
                display: block;
            }

    @@media print {
        body * {
            visibility: hidden;
        }

        #printArea, #printArea * {
            visibility: visible;
        }

        #printArea {
            position: fixed;
            inset: 0;
        }
    }

    .empty-state {
        min-height: 320px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

    .empty-illus {
        max-width: 160px;
        opacity: .85;
    }

    /* estilos del modal*/
    #saveOkModal .modal-content {
        box-shadow: 0 20px 50px rgba(0,0,0,.18);
        border-radius: 12px;
    }

    .ok-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        border: 4px solid #c8f5d1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f6fff8;
    }

        .ok-circle i {
            font-size: 36px;
            color: #22c55e;
        }

    .ok-img {
        width: 50px;
        height: 50px;
        object-fit: contain;
    }

    /*imagen limpiar campos*/
    #empty-search {
        width: 50px;
    }
</style>

<div class="caja-ui">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="tt mb-0">Listado de Caja</h2>

        <button class="btn btn-nuevo" id="btnNueva">
            <i class="bi bi-plus-circle me-1"></i> Nueva Caja
        </button>
    </div>

    <!-- Filtros -->
    <div class="card-filtros p-3 mb-3">
        <form id="frmFiltros" class="row g-3 align-items-end"
              data-endpoint="/Caja/Index" data-report="/Caja/ExportPdf">

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold">Código</label>
                <div class="clearable">
                    <input type="text" class="form-control" id="fCodigo" placeholder="Buscar por código" value="@qCodigo" />
                    <button type="button" class="btn-clear" aria-label="Limpiar"
                            onclick="this.previousElementSibling.value='';this.previousElementSibling.dispatchEvent(new Event('input'));">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold">Usuario</label>
                <div class="clearable">
                    <input type="text" class="form-control" id="fUsuario" placeholder="Buscar por usuario" value="@qUsuario" />
                    <button type="button" class="btn-clear" aria-label="Limpiar"
                            onclick="this.previousElementSibling.value='';this.previousElementSibling.dispatchEvent(new Event('input'));">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-2">
                <label class="form-label fw-semibold">Estado</label>
                <select id="fEstado" class="form-select">
                    <option value="" selected="@(qEstado == "" ? "selected" : null)">Todos</option>
                    @foreach (var e in Model.Estados)
                    {
                        <option value="@e.EstadoCajaID" selected="@(qEstado == e.EstadoCajaID.ToString() ? "selected" : null)">@e.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label fw-semibold">Desde</label>
                <input type="date" class="form-control" id="fDesde" value="@qDesde" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label fw-semibold">Hasta</label>
                <input type="date" class="form-control" id="fHasta" value="@qHasta" />
            </div>

            <div class="col-12 d-flex justify-content-end">
                <button type="button" id="btnPrint" class="btn btn-outline-secondary" title="Imprimir">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Tabla / Estado vacío -->
    <div id="printArea" class="card p-0">
        @if (!Model.Items.Any())
        {
            <div class="empty-state p-5 text-center">
                <img src="~/img/empty-search.png" asp-append-version="true" alt="Sin resultados"
                     class="mb-3 empty-illus" onerror="this.style.display='none'" id="empty-search" />
                <h5 class="fw-bold mb-1">No se encontró ningún registro</h5>
                <p class="text-muted mb-3">Ajusta los filtros o limpia la búsqueda.</p>

                <button type="button" class="btn btn-outline-secondary js-clear-filters">
                    <i class="bi bi-eraser me-1"></i> Limpiar filtros
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tblNumPaginador" class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width:140px">Código</th>
                            <th>Usuario</th>
                            <th style="width:170px">F. Apertura</th>
                            <th style="width:160px" class="text-end">Monto apertura</th>
                            <th style="width:170px">F. Cierre</th>
                            <th style="width:120px">Estado</th>
                            <th style="width:150px" class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td>@r.Codigo</td>
                                <td>@r.Usuario</td>
                                <td>@r.FechaApertura.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">Q. @r.MontoApertura.ToString("N2")</td>
                                <td>@(r.FechaCierre.HasValue? r.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                <td>
                                    @(r.Estado == "Abierta"
                                                                ? Html.Raw("<span class=\"pill pill-ok\">Abierta</span>")
                                                                : Html.Raw("<span class=\"pill pill-off\">Cerrada</span>"))
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-info btn-icon js-detalle" data-id="@r.CajaID" title="Detalle">
                                    <i class="bi bi-clipboard-data"></i>
                                </button>
                                @if (r.Estado == "Abierta")
                                        {
                                            <button class="btn btn-sm btn-outline-danger btn-icon js-cerrar" data-id="@r.CajaID" title="Cerrar">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center p-2">
                <div class="small text-muted"><span id="infoRows"></span></div>
                <nav><ul id="pager" class="pagination mb-0"></ul></nav>
            </div>
        }
    </div>
</div>

<div id="modalHost"></div>
<form id="frmAnti">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="saveOkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-4 text-center">
            <div class="ok-circle mx-auto mb-3">
                @* <i class="bi bi-check-lg"></i> *@
                <img src="~/img/advertencia.png" alt="Éxito" class="ok-img">
            </div>
            <h4 class="fw-bold mb-1">¡Hay una caja abierta!</h4>
            <p class="text-muted mb-0">Cierra la caja actual antes de abrir otra.</p>
        </div>
    </div>
</div>

<!-- Modal: resultado de apertura -->
<div class="modal fade" id="afterOpenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-4 text-center">
            <div class="ok-circle mx-auto mb-3">
                <img src="~/img/exito.png" alt="Éxito" class="ok-img">
            </div>
            <h4 class="fw-bold mb-1 js-title">Caja abierta</h4>
            <p class="text-muted mb-0 js-msg">La caja se abrió correctamente.</p>
        </div>
    </div>
</div>

<div class="modal fade" id="afterCloseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-4 text-center">
            <div class="ok-circle mx-auto mb-3">
                <img src="~/img/exito.png" alt="Éxito" class="ok-img">
            </div>
            <h4 class="fw-bold mb-1 js-title">Caja cerrada</h4>
            <p class="text-muted mb-0 js-msg">La caja se cerro correctamente.</p>
        </div>
    </div>
</div>

<!-- Modal de confirmación -->
<div class="modal fade" id="modalConfirmCerrar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
            </div>
            <h4 class="fw-bold mb-2">¿Cerrar esta caja?</h4>
            <p class="text-muted mb-4">Una vez cerrada, no se podrán realizar más operaciones en esta caja.</p>
            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmCerrar">Cerrar</button>
            </div>
        </div>
    </div>
</div>


<script>
    (function () {
        const fCodigo  = document.getElementById('fCodigo');
        const fUsuario = document.getElementById('fUsuario');
        const fEstado  = document.getElementById('fEstado');
        const fDesde   = document.getElementById('fDesde');
        const fHasta   = document.getElementById('fHasta');
        const host     = document.getElementById('modalHost');

        const DASHBOARD_URL = '/Home/Dashboard';

        // 0) Verifica Bootstrap
        function ensureBootstrap() {
            if (!window.bootstrap || !bootstrap.Modal) {
                console.error('Bootstrap JS no está cargado en esta vista.');
                alert('No se pudo abrir el modal porque Bootstrap JS no está cargado aquí.\nAsegúrate que el Layout del dashboard incluya bootstrap.bundle.js');
                return false;
            }
            return true;
        }

        // 1) Mover y mostrar modal
        function showModalById(id) {
            if (!ensureBootstrap()) return;
            const el = document.getElementById(id);
            if (!el) { console.warn('Modal no encontrado:', id); return; }
            if (el.parentElement !== document.body) document.body.appendChild(el);
            const inst = bootstrap.Modal.getOrCreateInstance(el);
            inst.show();
        }

        // 2) Filtros
        function buildUrl() {
            const qs  = new URLSearchParams();
            const cod = (fCodigo?.value  || '').trim();
            const usr = (fUsuario?.value || '').trim();
            const est = (fEstado?.value  ?? '');
            const des = (fDesde?.value   || '').trim();
            const has = (fHasta?.value   || '').trim();

            if (cod) qs.set('Codigo', cod);
            if (usr) qs.set('Usuario', usr);
            qs.set('EstadoCajaID', est); // "" = todos
            if (des) qs.set('FechaDesde', des);
            if (has) qs.set('FechaHasta', has);

            return '/Caja/Index' + (qs.toString() ? '?' + qs.toString() : '');
        }

        function debounce(fn, ms = 700) {
            let t;
            return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
        }

        const go = debounce(async () => {
            const url = buildUrl();

            // guarda foco/caret
            const active   = document.activeElement;
            const id       = active?.id;
            const selStart = ('selectionStart' in active) ? active.selectionStart : null;
            const selEnd   = ('selectionEnd'   in active) ? active.selectionEnd   : null;

            if (window.swapInHost) {
                // --- Escenario normal dentro del dashboard ---
                await window.swapInHost(url, '#printArea');
                window.initPuestosPager?.(document.getElementById('printArea'));

                // Mantener SIEMPRE la URL del dashboard con el initial
                history.replaceState(
                    null,
                    '',
                    `${DASHBOARD_URL}?initial=${encodeURIComponent(url)}`
                );
            } else {
                // --- Fallback si se entra directo a /Caja/Index sin dashboard ---
                const r = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (r.ok) {
                    const html   = await r.text();
                    const doc    = new DOMParser().parseFromString(html, 'text/html');
                    const newArea = doc.querySelector('#printArea');
                    const curArea = document.querySelector('#printArea');
                    if (newArea && curArea) curArea.replaceWith(newArea);
                    window.initPuestosPager?.(document.getElementById('printArea'));
                } else {
                    console.error('Error al recargar tabla:', r.status, await r.text());
                }
                history.replaceState(null, '', url);
            }

            // restaura foco/caret
            if (id) {
                const el = document.getElementById(id);
                if (el) {
                    el.focus();
                    if (selStart != null && selEnd != null && el.setSelectionRange) {
                        el.setSelectionRange(selStart, selEnd);
                    }
                }
            }
        }, 700);

        window.addEventListener('DOMContentLoaded', () => {
            window.initPuestosPager?.(document.getElementById('printArea'));
        });

        function onTextInput() {
            const v = this.value.trim();
            if (v.length === 0 || v.length >= 2) go();
        }

        fCodigo?.addEventListener('input', onTextInput);
        fUsuario?.addEventListener('input', onTextInput);
        fEstado?.addEventListener('change', go);
        fDesde?.addEventListener('change', go);
        fHasta?.addEventListener('change', go);

        // ====== IMPRESIÓN ======
        document.getElementById('btnPrint')?.addEventListener('click', () => {
            const base = buildUrl();
            const pdfUrl = base
                .replace('/Caja/Index', '/Caja/ExportPdf')
                .replace('/Index', '/ExportPdf'); // por si acaso
            window.open(pdfUrl, '_blank');
        });

        // ====== NUEVA CAJA ======
        document.getElementById('btnNueva')?.addEventListener('click', async () => {
            const r = await fetch('@Url.Action("Nueva", "Caja")', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            // Si el servidor devuelve 400 con el mensaje “Ya existe una caja abierta…”
            if (!r.ok) {
                const msg = (await r.text()) || 'No se pudo abrir el formulario.';
                showInfoModal('NUEVA CAJA', msg);
                return;
            }

            const html = await r.text();
            if (!html.trim()) {
                showInfoModal('NUEVA CAJA', 'La partial _NuevaCaja devolvió vacío.');
                return;
            }
            host.innerHTML = html;
            const el = document.getElementById('modalNueva');
            if (el && el.parentElement !== document.body) document.body.appendChild(el);
            bootstrap.Modal.getOrCreateInstance(el).show();
        });

        // Cierra el modal de nueva caja.
        function cleanupModalNuevaCaja() {
            const prev = document.getElementById('modalNueva');
            if (prev) {
                try { bootstrap.Modal.getInstance(prev)?.hide(); } catch { }
                document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                prev.remove();
            }
        }

        // Aviso inline dentro de un modal (snackbar simple)
        function showInlineBeforeForm(modalEl, msg = 'Ajuste agregado correctamente.', ms = 2500) {
            try {
                if (!modalEl) return;
                const form = modalEl.querySelector('#frmAjuste');
                const container = form || modalEl.querySelector('.modal-content');
                if (!container) return;

                const prev = modalEl.querySelector('.inline-ok-banner');
                if (prev) prev.remove();

                const banner = document.createElement('div');
                banner.className = 'inline-ok-banner';
                banner.setAttribute('role', 'status');
                banner.setAttribute('aria-live', 'polite');
                banner.style.cssText = `
                  position: relative;
                  margin: 8px 8px 0 8px;
                  border-radius: 8px;
                  background: #e8f7e9;
                  border: 1px solid #bfe8c2;
                  color: #166534;
                  font-weight: 600;
                  padding: 10px 12px;
                  display: flex;
                  align-items: center;
                  gap: 8px;
                  transition: opacity .25s ease, transform .25s ease;
                  opacity: 0;
                  transform: translateY(-6px);
                `;

                const icon = document.createElement('span');
                icon.textContent = '✔️';
                icon.style.flex = '0 0 auto';

                const text = document.createElement('span');
                text.textContent = msg;

                banner.appendChild(icon);
                banner.appendChild(text);

                if (form) {
                    form.insertAdjacentElement('beforebegin', banner);
                } else {
                    container.insertAdjacentElement('afterbegin', banner);
                }

                requestAnimationFrame(() => {
                    banner.style.opacity = '1';
                    banner.style.transform = 'translateY(0)';
                });

                if (modalEl._inlineOkTimer) clearTimeout(modalEl._inlineOkTimer);
                modalEl._inlineOkTimer = setTimeout(() => {
                    banner.style.opacity = '0';
                    banner.style.transform = 'translateY(-6px)';
                    setTimeout(() => banner.remove(), 260);
                    modalEl._inlineOkTimer = null;
                }, ms);
            } catch (e) {
                console.warn('showInlineBeforeForm error:', e);
            }
        }

        // Delegación submit: frmNueva y frmAjuste
        document.addEventListener('submit', async (ev) => {
            const form = ev.target;
            if (!form) return;

            // ======= ABRIR CAJA (frmNueva) =======
            if (form.id === 'frmNueva') {
                ev.preventDefault();

                if (form.dataset.sending === '1') return;
                form.dataset.sending = '1';

                const btn = form.querySelector('button[type="submit"]');
                btn?.setAttribute('disabled', 'disabled');

                try {
                    const r = await fetch('@Url.Action("Abrir", "Caja")', {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        credentials: 'same-origin'
                    });

                    if (!r.ok) {
                        const msg = await r.text().catch(() => '');
                        throw new Error(msg || 'No se pudo abrir la caja.');
                    }

                    const data = await r.json();

                    window.dispatchEvent(new CustomEvent('caja:changed', { detail: { abierta: true } }));

                    const m = document.getElementById('modalNueva');
                    if (m && window.bootstrap)
                        bootstrap.Modal.getOrCreateInstance(m).hide();

                    cleanupModalNuevaCaja();

                    showInfoModalafterOpenModal('Caja abierta', 'La caja se abrió correctamente.');

                    setTimeout(() => {
                        const url = data?.redirectUrl || '@Url.Action("Index", "Caja")';
                        if (window.loadToHost) window.loadToHost(url);
                        else window.location.href = url;
                    }, 1500);
                } catch (err) {
                    console.error(err);
                    alert(err.message || 'No se pudo abrir la caja (error de red).');
                    btn?.removeAttribute('disabled');
                    delete form.dataset.sending;
                }
                return;
            }

            // ======= AJUSTE DE CAJA (frmAjuste) =======
            if (form.id === 'frmAjuste') {
                ev.preventDefault();

                if (form.dataset.sending === '1') return;
                form.dataset.sending = '1';

                const btn = form.querySelector('button[type="submit"]');
                btn?.setAttribute('disabled', 'disabled');

                try {
                    const r = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        credentials: 'same-origin'
                    });

                    if (!r.ok) {
                        const msg = await r.text().catch(() => '');
                        alert(msg || 'No se pudo agregar el ajuste.');
                        return;
                    }

                    const data = await r.json();
                    if (!data.ok) {
                        alert(data.msg || 'No se pudo agregar el ajuste.');
                        return;
                    }

                    const r2 = await fetch(`/Caja/Detalle/${data.cajaId}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!r2.ok) {
                        console.error('Detalle no cargó:', r2.status, await r2.text());
                        alert('No se pudo refrescar el detalle.');
                        return;
                    }

                    const html = await r2.text();
                    const doc = new DOMParser().parseFromString(html, 'text/html');
                    const newModal = doc.querySelector('#modalDetalle');
                    if (!newModal) {
                        alert('Respuesta inválida del servidor.');
                        return;
                    }

                    let curModal = document.getElementById('modalDetalle');

                    if (!curModal) {
                        const host = document.getElementById('modalHost');
                        host.innerHTML = html;
                        curModal = document.getElementById('modalDetalle');
                        if (curModal && curModal.parentElement !== document.body)
                            document.body.appendChild(curModal);
                        bootstrap.Modal.getOrCreateInstance(curModal).show();
                    } else {
                        const curContent = curModal.querySelector('.modal-content');
                        const newContent = newModal.querySelector('.modal-content');
                        if (curContent && newContent) {
                            const cloned = document.importNode(newContent, true);
                            curContent.replaceWith(cloned);
                        }
                        bootstrap.Modal.getOrCreateInstance(curModal).show();
                    }

                    showInlineBeforeForm(curModal, 'Ajuste agregado correctamente.');
                } catch (err) {
                    console.error('Error procesando el ajuste:', err);
                    const curModal = document.getElementById('modalDetalle');
                    showInlineBeforeForm(curModal, 'Error al procesar el ajuste.');
                } finally {
                    btn?.removeAttribute('disabled');
                    delete form.dataset.sending;
                }

                return;
            }
        });

        // ====== DETALLE ======
        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('.js-detalle');
            if (!btn) return;

            const id = btn.dataset.id;
            const r = await fetch(`@Url.Content("~/Caja/Detalle/")${id}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!r.ok) { alert(await r.text()); return; }

            const html = await r.text();
            if (!html.trim()) { alert('La partial _DetalleCaja devolvió vacío'); return; }

            (function cleanupModalDetalle() {
                const prev = document.getElementById('modalDetalle');
                if (prev) {
                    try { bootstrap.Modal.getInstance(prev)?.hide(); } catch { }
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                    prev.remove();
                }
            })();

            host.innerHTML = html;
            showModalById('modalDetalle');
        });

        // ====== CERRAR CAJA ======
        let cajaIdToClose = null;

        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.js-cerrar');
            if (!btn) return;
            cajaIdToClose = btn.dataset.id;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalConfirmCerrar')).show();
        });

        document.getElementById('btnConfirmCerrar').addEventListener('click', async () => {
            if (!cajaIdToClose) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const fd = new FormData();
            if (token) fd.append('__RequestVerificationToken', token);

            const resp = await fetch(`@Url.Content("~/Caja/Cerrar/")${cajaIdToClose}`, {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            });

            bootstrap.Modal.getInstance(document.getElementById('modalConfirmCerrar'))?.hide();

            if (!resp.ok) { alert(await resp.text()); cajaIdToClose = null; return; }
            const data = await resp.json();
            window.dispatchEvent(new CustomEvent('caja:changed', { detail: { abierta: false } }));

            const goNext = () => {
                const url = data?.redirectUrl || '@Url.Action("Index", "Caja")';
                if (window.loadToHost) window.loadToHost(url);
                else window.location.href = url;
            };

            const okEl = document.getElementById('afterCloseModal');
            if (okEl) {
                okEl.addEventListener('hidden.bs.modal', goNext, { once: true });
                showInfoModalafterCloseModal('Caja cerrada', 'La caja se cerró correctamente.');
            } else {
                setTimeout(goNext, 300);
            }

            cajaIdToClose = null;
        });

        // ====== Botón "Limpiar filtros" (delegado en .caja-ui) ======
        document.querySelector('.caja-ui')?.addEventListener('click', (ev) => {
            const btn = ev.target.closest('.js-clear-filters');
            if (!btn) return;

            if (fCodigo)  fCodigo.value  = '';
            if (fUsuario) fUsuario.value = '';
            if (fEstado)  fEstado.value  = '';
            if (fDesde)   fDesde.value   = '';
            if (fHasta)   fHasta.value   = '';

            go();
        });

    })();

    // Helpers de mensajes (se mantienen igual)
    function showInfoModal(title, message) {
        const el = document.getElementById('saveOkModal');
        if (!el || !window.bootstrap) { alert(message); return; }
        const inst = bootstrap.Modal.getOrCreateInstance(el);
        inst.show();

        clearTimeout(el._autoTimer);
        el._autoTimer = setTimeout(() => {
            try { bootstrap.Modal.getInstance(el)?.hide(); } catch { }
        }, 1500);
    }

    function showInfoModalafterOpenModal(title, message) {
        const el = document.getElementById('afterOpenModal');
        if (!el || !window.bootstrap) { alert(message); return; }
        const inst = bootstrap.Modal.getOrCreateInstance(el);
        inst.show();

        clearTimeout(el._autoTimer);
        el._autoTimer = setTimeout(() => {
            try { bootstrap.Modal.getInstance(el)?.hide(); } catch { }
        }, 1500);
    }

    function showInfoModalafterCloseModal(title, message) {
        const el = document.getElementById('afterCloseModal');
        if (!el || !window.bootstrap) { alert(message); return; }
        const inst = bootstrap.Modal.getOrCreateInstance(el);
        inst.show();

        clearTimeout(el._autoTimer);
        el._autoTimer = setTimeout(() => {
            try { bootstrap.Modal.getInstance(el)?.hide(); } catch { }
        }, 1500);
    }
</script>

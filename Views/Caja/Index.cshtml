              // === CERRAR CAJA (bloque ÚNICO) ===
    let cajaIdToClose = null;

    // abrir modal de confirmación
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.js-cerrar');
      if (!btn) return;
      cajaIdToClose = btn.dataset.id;
      bootstrap.Modal.getOrCreateInstance(document.getElementById('modalConfirmCerrar')).show();
    });

    // confirmar y cerrar
    document.getElementById('btnConfirmCerrar').addEventListener('click', async () => {
      if (!cajaIdToClose) return;

      const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
      const fd = new FormData();
      if (token) fd.append('__RequestVerificationToken', token);

      const resp = await fetch(`@Url.Content("~/Caja/Cerrar/")${cajaIdToClose}`, {
        method: 'POST',
        body: fd,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      });

      bootstrap.Modal.getInstance(document.getElementById('modalConfirmCerrar'))?.hide();

      if (!resp.ok) { alert(await resp.text()); cajaIdToClose = null; return; }
      const data = await resp.json();
      window.dispatchEvent(new CustomEvent('caja:changed', { detail: { abierta: false } }));

      // --- Opción A: redirigir directo, sin depender de modal "ok"
      const go = () => {
        const url = data?.redirectUrl || '@Url.Action("Index", "Caja")';
        if (window.loadToHost) window.loadToHost(url);
        else window.location.href = url;
      };

      // Si tienes showInfoModalafterCloseModal, úsalo SI y SOLO SI el modal existe
      const okEl = document.getElementById('afterCloseModal');
      if (okEl) {
        okEl.addEventListener('hidden.bs.modal', go, { once: true });
        // muestra y auto-cierra con tu helper
        showInfoModalafterCloseModal('Caja cerrada', 'La caja se cerró correctamente.');
      } else {
        // sin modal: pequeña pausa opcional y navega
        setTimeout(go, 300);
      }

      cajaIdToClose = null;
    });


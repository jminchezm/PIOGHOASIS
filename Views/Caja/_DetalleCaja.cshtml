@model PIOGHOASIS.Models.ViewModels.DetalleCajaVM

<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content p-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="m-0">Estado/Detalle de Caja (@Model.Codigo)</h5>
                @* <button class="btn btn-link" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i></button> *@
                <div class="btn-group">
                    <a class="btn btn-outline-secondary btn-sm"
                       href="/Caja/DetallePdf/@Model.CajaID" target="_blank" title="Imprimir">
                        <i class="bi bi-printer"></i>
                    </a>
                    <button class="btn btn-link" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col">
                    <div><strong>Abierta desde:</strong> @Model.FechaApertura</div>
                    @if (Model.EstaCerrada)
                    {
                        <div><strong>Cerrada desde:</strong> @Model.FechaCierre</div>
                    }
                </div>
            </div>

            <h6 class="mt-3">Ingresos del Turno</h6>
            <div class="row">
                <div class="col-6 col-md-4">Efectivo</div><div class="col-6 col-md-2 text-end">Q. @Model.Resumen.Efectivo</div>
                <div class="col-6 col-md-4">Transferencia</div><div class="col-6 col-md-2 text-end">Q. @Model.Resumen.Transferencia</div>
                <div class="col-6 col-md-4">Depósito</div><div class="col-6 col-md-2 text-end">Q. @Model.Resumen.Deposito</div>
                <div class="col-6 col-md-4">Compra clic</div><div class="col-6 col-md-2 text-end">Q. @Model.Resumen.CompraClick</div>
                <div class="col-6 col-md-4">Plataforma</div><div class="col-6 col-md-2 text-end">Q. @Model.Resumen.PlataformaReservas</div>
            </div>

            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle">
                    <thead class="table-warning">
                        <tr>
                            <th>#</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Reservación</th>  @* NUEVO *@
                            <th class="text-end">Monto</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pagos)
                        {
                            <tr>
                                <td>@p.Nro</td>
                                <td>@p.Fecha</td>
                                <td>@p.Cliente</td>
                                <td>@p.ReservaCodigo</td>
                                <td class="text-end">Q. @p.Monto</td>
                            </tr>
                        }   
                    </tbody>
                </table>
            </div>

            <!-- Totales + Ajustes -->
            <div class="row g-2 mt-2">
                <div class="col-6 col-md-4 fw-bold">TOTAL INGRESOS</div>
                <div class="col-6 col-md-2 text-end">Q. @Model.TotalIngresos.ToString("N2")</div>

                <div class="col-6 col-md-4 fw-bold">MONTO APERTURA</div>
                <div class="col-6 col-md-2 text-end">Q. @Model.MontoApertura.ToString("N2")</div>

                <div class="col-6 col-md-4 fw-bold">AJUSTES (+)</div>
                <div class="col-6 col-md-2 text-end">Q. @Model.Resumen.AjustesIngreso.ToString("N2")</div>

                <div class="col-6 col-md-4 fw-bold">AJUSTES (−)</div>
                <div class="col-6 col-md-2 text-end">Q. @Model.Resumen.AjustesEgreso.ToString("N2")</div>

                <div class="col-6 col-md-4 fw-bold">TOTAL FINAL</div>
                <div class="col-6 col-md-2 text-end fw-bold">Q. @Model.TotalFinal.ToString("N2")</div>
            </div>

            <!-- Formulario de ajuste (solo si la caja está abierta) -->
            @if (!Model.EstaCerrada)
            {
                <hr />
                //acá
                <form id="frmAjuste" method="post" action="/Caja/AgregarAjuste" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CajaID" value="@Model.CajaID" />

                    <div class="col-12 col-md-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" name="Tipo" required>
                            <option value="1">Ingreso (+)</option>
                            <option value="2">Egreso (−)</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Monto</label>
                        <input type="number" step="0.01" min="0.01" name="Monto" class="form-control" required />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">Motivo</label>
                        <input type="text" maxlength="200" name="Motivo" class="form-control" placeholder="Diferencia de caja, redondeo, etc." required />
                    </div>

                    <div class="col-12 col-md-2 d-grid">
                        <button class="btn btn-primary">Agregar</button>
                    </div>
                </form>
            }

            <!-- Lista de ajustes -->
            <h6 class="mt-3">Ajustes</h6>
            @if (!(Model.Ajustes?.Any() ?? false))
            {
                <div class="text-muted small">No hay ajustes registrados.</div>
            }
            else
            {
                <div class="table-responsive mt-2">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Fecha</th><th>Tipo</th><th>Motivo</th><th class="text-end">Monto</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Ajustes)
                            {
                                <tr>
                                    <td>@a.Fecha</td>
                                    <td>@a.TipoTxt</td>
                                    <td>@a.Motivo</td>
                                    <td class="text-end">Q. @a.Monto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>



@model PIOGHOASIS.Models.ViewModels.ReporteReservasVM
@{
    Layout = null;
    ViewData["Title"] = "Reportes de Reservas";
}

<style>
    .caja-ui {
        position: relative;
        margin-top: 0;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        background: linear-gradient(rgba(255,255,255,.30), rgba(255,255,255,.30)), url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        padding: 30px;
    }

    .caja-ui .card-filtros {
        background: rgba(255,255,255,.90);
        box-shadow: 0 6px 22px rgba(0,0,0,.08);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
    }

    .caja-ui .tt {
        font-size: clamp(1.25rem,1.8vw,1.75rem);
        font-weight: 800;
        color: #1f2a37;
    }

    .caja-ui table {
        background: #fff;
    }

    .caja-ui thead th {
        background: #f3c259;
        color: #222;
        border-bottom: 2px solid #d7a536;
        vertical-align: middle;
    }

    .caja-ui tbody td {
        vertical-align: middle;
    }

    .kpi-card .small {
        color: #6b7280;
    }

    .kpi-card {
        border-radius: .75rem;
    }
</style>

@functions {
    string EstadoBadgeClass(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return "bg-secondary-subtle text-secondary";

        var e = estado.ToUpper();
        if (e.Contains("CONFIRM")) return "bg-success-subtle text-success";
        if (e.Contains("RESERV")) return "bg-primary-subtle text-primary";
        if (e.Contains("CANCEL")) return "bg-danger-subtle text-danger";

        return "bg-secondary-subtle text-secondary";
    }
}

<div class="caja-ui">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="tt mb-0">Reportes de Reservas</h2>
    </div>

    <!-- Filtros -->
    <div class="card-filtros p-3 mb-3">
        <form method="get"
              class="row g-3 align-items-end"
              action="@Url.Action("Reservas","Reportes")"
              id="frmReportes">

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small text-uppercase text-muted">Desde</label>
                <input type="date"
                       name="desde"
                       class="form-control"
                       value="@Model.Desde?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small text-uppercase text-muted">Hasta</label>
                <input type="date"
                       name="hasta"
                       class="form-control"
                       value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small text-uppercase text-muted">Estado</label>
                <select name="estado" class="form-select">
                    @foreach (var e in Model.Estados)
                    {
                        <option value="@e.Value"
                                selected="@(e.Selected ? "selected" : null)">
                            @e.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small text-uppercase text-muted">Habitación</label>
                <select name="habitacionId" class="form-select">
                    @foreach (var h in Model.Habitaciones)
                    {
                        <option value="@h.Value"
                                selected="@(h.Selected ? "selected" : null)">
                            @h.Text
                        </option>
                    }
                </select>
            </div>


            <div class="col-12 d-flex justify-content-end mt-2 gap-2">
                <button class="btn btn-primary">
                    <i class="bi bi-search me-1"></i> Aplicar filtros
                </button>
                <button type="button" id="btnPrintRep" class="btn btn-outline-secondary" title="Imprimir">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="small text-muted text-uppercase fw-semibold mb-1">Habitaciones reservadas</div>
                    <div class="h3 mb-0 fw-bold">@Model.NumReservasReservadas</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="small text-muted text-uppercase fw-semibold mb-1">Habitaciones confirmadas</div>
                    <div class="h3 mb-0 fw-bold">@Model.NumReservasConfirmadas</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="small text-muted text-uppercase fw-semibold mb-1">Habitaciones canceladas</div>
                    <div class="h3 mb-0 fw-bold">@Model.NumReservasCanceladas</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="small text-muted text-uppercase fw-semibold mb-1">Total cobrado</div>
                    <div class="h3 mb-0 fw-bold">Q @Model.TotalCobrado.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla: Reservas -->
    <div id="printArea" class="card p-0 mb-3">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:140px">Código</th>
                        <th>Estado</th>
                        <th style="width:170px">Check-In</th>
                        <th style="width:170px">Check-Out</th>
                        <th>Cliente</th>
                        <th>Habitación</th>
                        <th class="text-end" style="width:140px">Total</th>
                        <th class="text-end" style="width:140px">Pagado</th>
                        <th class="text-end" style="width:140px">Pendiente</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reservas)
                    {
                        <tr>
                            <td>@r.Codigo</td>
                            <td>
                                <span class="badge rounded-pill @EstadoBadgeClass(r.Estado)">
                                    @r.Estado
                                </span>
                            </td>
                            <td>@r.In.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@r.Out.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@r.Cliente</td>
                            <td>@r.Hab</td>
                            <td class="text-end">@r.Total.ToString("N2")</td>
                            <td class="text-end">@r.Pagado.ToString("N2")</td>
                            <td class="text-end">@r.Pendiente.ToString("N2")</td>
                        </tr>
                    }
                    @if (!Model.Reservas.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                No hay reservas en el rango seleccionado.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tabla: Pagos -->
    <div class="card p-0">
        <div class="card-header fw-bold">
            Pagos (@Model.Desde?.ToString("dd/MM/yyyy") – @Model.Hasta?.ToString("dd/MM/yyyy"))
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:170px">Fecha</th>
                        <th>Tipo</th>
                        <th>Plataforma</th>
                        <th style="width:140px">Reserva</th>
                        <th class="text-end" style="width:140px">Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Pagos)
                    {
                        <tr>
                            <td>@p.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@p.Tipo</td>
                            <td>@(p.Plataforma ?? "—")</td>
                            <td>@p.CodigoReserva</td>
                            <td class="text-end">@p.Monto.ToString("N2")</td>
                        </tr>
                    }
                    @if (!Model.Pagos.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No hay pagos en el rango seleccionado.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('btnPrintRep')?.addEventListener('click', function () {
        const f = document.getElementById('frmReportes');
        if (!f) return;
        const qs = new URLSearchParams(new FormData(f));
        window.open('/Reportes/ReservasPdf?' + qs.toString(), '_blank');
    });
</script>

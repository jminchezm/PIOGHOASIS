@model PIOGHOASIS.Models.ViewModels.ReporteIngresosVM
@using System.Text.Json
@{
    Layout = null;
    ViewData["Title"] = "Reporte de Ingresos";

    var tipos = (IEnumerable<PIOGHOASIS.Models.TipoPago>)ViewBag.TiposPago;
    var formas = (IEnumerable<PIOGHOASIS.Models.FormaPago>)ViewBag.FormasPago;
    var plats = (IEnumerable<PIOGHOASIS.Models.PlataformaReserva>)ViewBag.Plataformas;

    string J(object o) => JsonSerializer.Serialize(o);
}

<style>
    /* ====== MISMO LOOK & FEEL QUE Reservas.cshtml ====== */
    .caja-ui {
        position: relative;
        margin-top: 0;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        background: linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,.30)), url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        padding: 30px;
    }

        .caja-ui .tt {
            font-size: clamp(1.25rem,1.8vw,1.75rem);
            font-weight: 800;
            color: #1f2a37
        }

        .caja-ui .card-filtros {
            background: rgba(255,255,255,.85);
            box-shadow: 0 6px 22px rgba(0,0,0,.08);
            border: 1px solid rgba(0,0,0,.06);
            border-radius: .75rem;
        }

        .caja-ui table {
            background: #fff
        }

        .caja-ui thead th {
            background: #f3c259;
            color: #222;
            border-bottom: 2px solid #d7a536;
            vertical-align: middle;
        }

        .caja-ui tbody td {
            vertical-align: middle
        }

    .kpi-card .small {
        color: #6b7280
    }

    #botones{
        /* background-color:pink; */
        width: 100%;
    }

    #tituloReporte{
        margin-bottom: 10px;
    }
</style>

<!-- Chart.js (solo para esta vista) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="caja-ui">
    @* <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="tt mb-0">Reporte de Ingresos</h2>
        <button id="btnPrintIng" type="button" class="btn btn-outline-secondary" title="Imprimir">
            <i class="bi bi-printer"></i>
        </button>
    </div> *@
    <div id="tituloReporte">
        <h2 class="tt mb-0">Reporte de pagos/ingresos</h2>
    </div>

    <!-- ===== Filtros (mismo bloque visual) ===== -->
    <div class="card-filtros p-3 mb-3">
        <form method="get" class="row g-3 align-items-end" id="frmIngresos" action="@Url.Action("PagosIngresos","Reportes")">
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold">Desde</label>
                <input type="date" name="desde" class="form-control" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label fw-semibold">Hasta</label>
                <input type="date" name="hasta" class="form-control" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label fw-semibold">Tipo de pago</label>
                <select class="form-select" name="tipoPagoId">
                    <option value="">Todos</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t.TipoPagoID" selected="@(Model.TipoPagoId == t.TipoPagoID ? "selected" : null)">@t.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label fw-semibold">Forma de pago</label>
                <select class="form-select" name="formaPagoId">
                    <option value="">Todas</option>
                    @foreach (var f in formas)
                    {
                        <option value="@f.FormaPagoID" selected="@(Model.FormaPagoId == f.FormaPagoID ? "selected" : null)">@f.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label fw-semibold">Plataforma</label>
                <select class="form-select" name="plataformaId">
                    <option value="">Todas</option>
                    @foreach (var p in plats)
                    {
                        <option value="@p.PlataformaID" selected="@(Model.PlataformaId == p.PlataformaID ? "selected" : null)">@p.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3 d-flex justify-content-end" id="botones">
                <button class="btn btn-primary mt-2">
                    <i class="bi bi-search me-1"></i> Buscar
                </button>
                <button type="button" id="btnPrintIng2" class="btn btn-outline-secondary ms-2 mt-2" title="Imprimir">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- ===== KPIs (misma estética) ===== -->
    <div class="row g-3 mb-3 justify-content-center">
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card">
                <div class="card-body">
                    <div class="small">Total cobrado</div>
                    <div class="h4 mb-0">Q. @Model.TotalCobrado.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card">
                <div class="card-body">
                    <div class="small"># Pagos</div>
                    <div class="h4 mb-0">@Model.CantPagos</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card">
                <div class="card-body">
                    <div class="small">Ticket promedio</div>
                    <div class="h4 mb-0">Q. @Model.TicketPromedio.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Dashboards ===== -->
    <div class="row g-3 mb-3 justify-content-center">
        <div class="col-lg-4">
            <div class="card p-0">
                <div class="card-header fw-bold">Por tipo de pago</div>
                <div class="card-body"><canvas id="chTipo" height="220"></canvas></div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="card p-0">
                <div class="card-header fw-bold">Por plataforma</div>
                <div class="card-body"><canvas id="chPlat" height="220"></canvas></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-0">
                <div class="card-header fw-bold">Ingresos por día</div>
                <div class="card-body"><canvas id="chDia" height="220"></canvas></div>
            </div>
        </div>
    </div>

    <!-- ===== Tabla de pagos ===== -->
    <div class="card p-0">
        <div class="card-header fw-bold">
            Pagos (@Model.Desde – @Model.Hasta)
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:150px">Fecha</th>
                        <th>Tipo</th>
                        <th>Forma</th>
                        <th>Plataforma</th>
                        <th>Reserva</th>
                        <th>Cliente</th>
                        <th class="text-end" style="width:120px">Monto</th>
                        <th>Referencia</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Pagos.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Sin pagos.</td></tr>
                    }
                    else
                    {
                        foreach (var p in Model.Pagos)
                        {
                            <tr>
                                <td>@p.FechaPago</td>
                                <td>@p.TipoPago</td>
                                <td>@p.FormaPago</td>
                                <td>@(p.Plataforma ?? "—")</td>
                                <td>@p.ReservaCodigo</td>
                                <td>@p.Cliente</td>
                                <td class="text-end">Q. @p.Monto.ToString("N2")</td>
                                <td>@(string.IsNullOrWhiteSpace(p.NumeroReferencia) ? "—" : p.NumeroReferencia)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    (() => {
      // --- Datos desde el modelo ---
      const porTipo = @Html.Raw(J(Model.PorTipoPago));
      const porPlat = @Html.Raw(J(Model.PorPlataforma));
      const porDia  = @Html.Raw(J(Model.PorDia.Select(x => new { d = x.Dia.ToString("yyyy-MM-dd"), m = x.Monto })));

      // Paleta amigable
      const COLORS = ['#3B82F6','#EF4444','#22C55E','#EAB308','#8B5CF6','#06B6D4','#F97316','#10B981','#F43F5E','#6366F1'];

      // 1) Tipo de pago (barras)
      new Chart(document.getElementById('chTipo'), {
        type: 'bar',
        data: {
          labels: porTipo.map(x => x.Clave),
          datasets: [{
            label: 'Q',
            data: porTipo.map(x => x.Monto),
            backgroundColor: porTipo.map((_,i)=>COLORS[i%COLORS.length])
          }]
        },
        options: { responsive: true, plugins: { legend: { display:false } } }
      });

      // 2) Plataforma (dona)
      new Chart(document.getElementById('chPlat'), {
        type: 'doughnut',
        data: {
          labels: porPlat.map(x => x.Clave),
          datasets: [{
            data: porPlat.map(x => x.Monto),
            backgroundColor: porPlat.map((_,i)=>COLORS[i%COLORS.length])
          }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
      });

      // 3) Por día (línea)
      new Chart(document.getElementById('chDia'), {
        type: 'line',
        data: {
          labels: porDia.map(x => x.d),
          datasets: [{
            label: 'Q por día',
            data: porDia.map(x => x.m),
            borderColor: COLORS[0],
            backgroundColor: 'rgba(59,130,246,.20)',
            tension: .25,
            fill: true,
            pointRadius: 2.5
          }]
        },
        options: { responsive: true, plugins: { legend: { display:false } } }
      });

      // --- Imprimir (misma UX que Reservas) ---
      function openPrint(){
        const f = document.getElementById('frmIngresos');
        if(!f) return;
        const qs = new URLSearchParams(new FormData(f));
        window.open('/Reportes/PagosIngresosPdf?' + qs.toString(), '_blank');
      }
      document.getElementById('btnPrintIng')?.addEventListener('click', openPrint);
      document.getElementById('btnPrintIng2')?.addEventListener('click', openPrint);
    })();
</script>

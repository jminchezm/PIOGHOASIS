@model PIOGHOASIS.Models.ViewModels.ReporteReservasVM
@{
    Layout = null;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var logoUrl = baseUrl + Url.Content("~/img/login/logo-oasis.png");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte de Reservas</title>
    <style>
        html, body {
            font-family: Arial,Helvetica,sans-serif;
            font-size: 12px;
            color: #1f2a37
        }

        .container {
            padding: 10mm 10mm
        }

        .brand {
            display: table;
            width: 100%;
            border-bottom: 3px solid #d7a536;
            padding-bottom: 8px;
            margin-bottom: 10px
        }

            .brand .left {
                display: table-cell;
                vertical-align: middle;
                width: 1%
            }

            .brand .right {
                display: table-cell;
                vertical-align: middle;
                padding-left: 10px
            }

        .logo {
            width: 150px;
            height: auto
        }

        .title {
            margin: 0;
            font-size: 20px;
            line-height: 1.2;
            font-weight: 800;
            color: #1f2a37
        }

        .meta {
            margin-top: 2px;
            color: #6b7280;
            font-size: 12px
        }

        .grid2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px
        }

        .kpi {
            border: 1px solid #ddd;
            padding: 8px;
            border-radius: 6px
        }

            .kpi .lbl {
                color: #6b7280;
                font-size: 12px
            }

            .kpi .val {
                font-size: 18px;
                font-weight: 700
            }

        table {
            width: 100%;
            border-collapse: collapse
        }

        th, td {
            border: 1px solid #ddd;
            padding: 6px
        }

        th {
            background: #f7e1a5;
            text-align: left
        }

        .right {
            text-align: right
        }

        tbody tr:nth-child(even) {
            background: #fffaf0
        }
    </style>
</head>
<body>
    <div class="container">

        <div class="brand">
            <div class="left"><img class="logo" src="@logoUrl" alt="Hotel Oasis" /></div>
            <div class="right">
                <h1 class="title">Reporte de Reservas</h1>
                <div class="meta">
                    Periodo: @Model.Desde – @Model.Hasta &nbsp; | &nbsp;
                    @(Model.ModoPorPagos ? "Filtrado por pagos" : "Filtrado por estancias") &nbsp; | &nbsp;
                    Generado: @DateTime.Now
                </div>
            </div>
        </div>

        <div class="grid2" style="margin-bottom:10px;">
            <div class="kpi"><div class="lbl">Ocupación</div><div class="val">@((Model.Ocupacion * 100m).ToString("0.0")) %</div></div>
            <div class="kpi"><div class="lbl">Precio prom./n vendida (Sin impuestos)</div><div class="val">@Model.ADR.ToString("N2")</div></div> @* ADR *@
            <div class="kpi"><div class="lbl">Ingreso por habitación disponible</div><div class="val">@Model.RevPAR.ToString("N2")</div></div> @* RevPAR *@
            <div class="kpi"><div class="lbl">Total Cobrado</div><div class="val">@Model.TotalCobrado.ToString("N2")</div></div>
        </div>

        <h3>Reservas</h3>
        <table>
            <thead>
                <tr>
                    <th style="width:120px">Código</th>
                    <th>Estado</th>
                    <th style="width:140px">Check-In</th>
                    <th style="width:140px">Check-Out</th>
                    <th>Cliente</th>
                    <th>Habitación</th>
                    <th class="right" style="width:110px">Total</th>
                    <th class="right" style="width:110px">Pagado</th>
                    <th class="right" style="width:110px">Pendiente</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Reservas.Any())
                {
                    <tr><td colspan="9">Sin reservas en el periodo.</td></tr>
                }
                else
                {
                    foreach (var r in Model.Reservas)
                    {
                        <tr>
                            <td>@r.Codigo</td>
                            <td>@r.Estado</td>
                            <td>@r.In</td>
                            <td>@r.Out</td>
                            <td>@r.Cliente</td>
                            <td>@r.Hab</td>
                            <td class="right">@r.Total.ToString("N2")</td>
                            <td class="right">@r.Pagado.ToString("N2")</td>
                            <td class="right">@r.Pendiente.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <h3 style="margin-top:12px">Pagos (@Model.Desde – @Model.Hasta)</h3>
        <table>
            <thead>
                <tr>
                    <th style="width:140px">Fecha</th>
                    <th>Tipo</th>
                    <th>Plataforma</th>
                    <th style="width:120px">Reserva</th>
                    <th class="right" style="width:110px">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Pagos.Any())
                {
                    <tr><td colspan="5">Sin pagos en el periodo.</td></tr>
                }
                else
                {
                    foreach (var p in Model.Pagos)
                    {
                        <tr>
                            <td>@p.FechaPago</td>
                            <td>@p.Tipo</td>
                            <td>@(p.Plataforma ?? "—")</td>
                            <td>@p.CodigoReserva</td>
                            <td class="right">@p.Monto.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</body>
</html>

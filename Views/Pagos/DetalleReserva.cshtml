@model PIOGHOASIS.Models.ViewModels.PagoDetalleReservaVM
@{
    Layout = null;
    var r = Model.Reserva;
    var sel = Model.Seleccionado;

    bool hasFile = sel != null && !string.IsNullOrWhiteSpace(sel.ComprobantePath);
    bool isImg = sel != null && !string.IsNullOrWhiteSpace(sel.ComprobanteMime) && sel.ComprobanteMime.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    bool isPdf = sel != null && !string.IsNullOrWhiteSpace(sel.ComprobanteMime) && sel.ComprobanteMime.Contains("pdf", StringComparison.OrdinalIgnoreCase);

    var volverUrl = Url.Action("Index", "Reservas");
    var verPdfReserva = Url.Action("ReservaPdf", "Reservas", new { id = r.ReservaID, _ = DateTimeOffset.Now.ToUnixTimeSeconds() });

    // ===== Badge de estado =====
    var estadoNombre = r.Estado?.Nombre ?? "";
    var estadoCodigo = r.Estado?.Codigo ?? "";

    string badgeEstadoClass = "badge-status badge-otro";
    if (estadoNombre.Contains("CANCEL", StringComparison.OrdinalIgnoreCase))
    {
        badgeEstadoClass = "badge-status badge-cancelada";
    }
    else if (estadoNombre.Contains("CONFIRM", StringComparison.OrdinalIgnoreCase))
    {
        badgeEstadoClass = "badge-status badge-confirmada";
    }
    else if (estadoNombre.Contains("RESERV", StringComparison.OrdinalIgnoreCase))
    {
        badgeEstadoClass = "badge-status badge-reservada";
    }
}

<style>
    /* ====== LAYOUT base ====== */
    .pay-create {
        position: relative;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        padding: 24px;
        background: linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,.30)),url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        background-attachment: fixed;
        background-position: center center;
        background-size: cover;
    }

    .pc-back {
        position: sticky;
        top: calc(var(--header-h) + 8px);
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: #4b5563;
        color: #fff;
        border: none;
        border-radius: .5rem;
        padding: .4rem .75rem;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0,0,0,.15);
    }

        .pc-back:hover {
            filter: brightness(.95);
            color: #fff;
        }

    .pc-card {
        background: rgba(255,255,255,.9);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(3px);
    }

    /* ====== Header compacto ====== */
    .pc-header {
        background: #f0a100;
        color: #1f2a37;
        padding: .45rem .9rem;
        border-top-left-radius: .75rem;
        border-top-right-radius: .75rem;
        border-bottom: 1px solid #d7a536;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .pc-header-title {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-weight: 800;
        font-size: .95rem;
    }

    .pc-header-sub {
        font-size: .8rem;
        opacity: .9;
    }

    .pc-subtitle {
        font-weight: 800;
        color: #1f2a37;
        border-left: 4px solid #f0a100;
        padding-left: .5rem;
        margin: .25rem 0 1rem;
    }

    .badge-soft {
        display: inline-block;
        padding: .2rem .5rem;
        border-radius: 999px;
        background: #eef2ff;
        border: 1px solid #e5e7eb;
        font-weight: 700;
        font-size: .8rem;
    }

    /* ====== Badges de estado de reserva ====== */
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        padding: .15rem .5rem;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .badge-reservada {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fbbf24;
    }

    .badge-confirmada {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #22c55e;
    }

    .badge-cancelada {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #f97373;
    }

    .badge-otro {
        background: #e5e7eb;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    /* ====== Franja de resumen ====== */
    .summary-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: .7rem .9rem;
        background: #f9fafb;
        border-radius: .65rem;
        border: 1px solid #e5e7eb;
        margin-bottom: 1rem;
    }

    .summary-left {
        min-width: 180px;
    }

    .summary-left-title {
        font-weight: 800;
        font-size: .95rem;
    }

    .summary-left-sub {
        font-size: .8rem;
        color: #4b5563;
    }

    .summary-right {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
    }

    .summary-item {
        min-width: 90px;
    }

    .summary-item-label {
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6b7280;
        margin-bottom: 2px;
    }

    .summary-item-value {
        font-weight: 800;
        font-size: .9rem;
    }

    @@media (max-width: 576px) {
        .summary-strip

    {
        align-items: flex-start;
    }

    .summary-right {
        width: 100%;
        justify-content: flex-start;
    }

    }

    /* ====== Vista previa / contenedores ====== */
    .preview-box {
        background: #fff;
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        padding: 10px;
    }

    .preview-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
        margin-top: 8px;
    }

    /* ====== Área comprobante de pago ====== */
    #comprobantePago {
        --cp-h: 375px;
    }
    @@media (max-width: 992px) {
        #comprobantePago

    {
        --cp-h: 420px;
    }

    }

    #comprobantePago .preview-box {
        height: var(--cp-h);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        #comprobantePago .preview-box > embed,
        #comprobantePago .preview-box > img {
            width: 100%;
            height: calc(var(--cp-h) - 42px) !important;
            object-fit: contain;
            border-radius: .5rem;
        }

    /* ====== Tabla de pagos ====== */
    .table-payments thead th {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        border-bottom-width: 1px;
        background-color: #f9fafb;
    }

    .table-payments tbody td {
        font-size: .85rem;
        vertical-align: middle;
    }

    .table-payments tr.table-primary > td {
        background-color: #e0edff !important;
    }

    .text-xs {
        font-size: .75rem;
    }

    /* ====== Flash modal ====== */
    .flash-mask {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,.35);
        z-index: 2000;
    }

    .flash-card {
        background: #fff;
        border-radius: .75rem;
        width: min(520px, 92%);
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
        overflow: hidden;
        border: 1px solid rgba(0,0,0,.06);
    }

    .flash-head {
        padding: 12px 16px;
        font-weight: 800;
        color: #1f2a37;
        border-bottom: 1px solid #eee;
    }

    .flash-body {
        padding: 14px 16px;
    }

    .flash-ok {
        background: #e7f9ed;
        border-bottom: 2px solid #bfe8c2;
    }

    .flash-warn {
        background: #fff7ed;
        border-bottom: 2px solid #f8d39a;
    }

    .flash-info {
        background: #e7f9fd;
        border-bottom: 2px solid #beeaf3;
    }

    .flash-error {
        background: #fff0f0;
        border-bottom: 2px solid #f5c2c7;
    }
</style>

<div class="pay-create">
    <div class="d-flex justify-content-end mb-2">
        <a class="pc-back ajax-nav" href="/Home/Dashboard" data-url="@volverUrl">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>

    <div class="pc-card">
        <!-- HEADER compacto -->
        <div class="pc-header">
            <div>
                <div class="pc-header-title">
                    Detalle de pagos
                    @if (!string.IsNullOrWhiteSpace(estadoNombre))
                    {
                        <span class="@badgeEstadoClass">
                            <i class="bi bi-circle-fill" style="font-size:.5rem;"></i>
                            @estadoNombre
                        </span>
                    }
                </div>
                <div class="pc-header-sub d-none d-sm-block">
                    Reserva @r.Codigo
                </div>
            </div>
        </div>

        <div class="p-3 p-md-4">
            <!-- FRANJA DE RESUMEN -->
            <div class="summary-strip">
                <div class="summary-left">
                    <div class="summary-left-title">Reserva @r.Codigo</div>
                    <div class="summary-left-sub">
                        @r.Cliente?.Persona?.PrimerNombre @r.Cliente?.Persona?.PrimerApellido
                    </div>
                </div>

                <div class="summary-right">
                    <div class="summary-item">
                        <div class="summary-item-label">Total reserva</div>
                        <div class="summary-item-value">Q @r.Total.ToString("N2")</div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-item-label">Pagado</div>
                        <div class="summary-item-value">Q @Model.Pagado.ToString("N2")</div>
                    </div>
                    <div class="summary-item">
                        <div class="summary-item-label">Pendiente</div>
                        <div class="summary-item-value">
                            <span class="badge-soft">Q @Model.Pendiente.ToString("N2")</span>
                        </div>
                    </div>

                    @* <a class="btn btn-sm btn-outline-primary ajax-nav"
                       href="/Home/Dashboard"
                       data-url="@Url.Action("Nueva", "Pagos", new { reservaId = r.ReservaID })">
                        <i class="bi bi-plus-circle"></i> Registrar nuevo pago
                    </a> *@
                </div>
            </div>

            <div class="row g-3">
                <!-- Columna izquierda: pagos + comprobante -->
                <div class="col-12 col-lg-6">
                    <h6 class="pc-subtitle">Historial de pagos</h6>

                    @if (!(Model.Pagos?.Any() ?? false))
                    {
                        <div class="alert alert-light border">
                            No hay pagos registrados para esta reserva.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-hover align-middle table-payments">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Forma</th>
                                        <th>Tipo</th>
                                        <th>Plataforma</th>
                                        <th>Referencia</th>
                                        <th class="text-end">Monto</th>
                                        <th class="text-end" style="width:130px">Comprobante</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Pagos)
                                    {
                                        <tr class="@(Model.Seleccionado?.PagoReservaID == p.PagoReservaID ? "table-primary" : "")">
                                            <td>@p.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@p.FormaPago?.Nombre</td>
                                            <td>@p.TipoPago?.Nombre</td>
                                            <td>@(p.Plataforma?.Nombre ?? "—")</td>
                                            <td>@(string.IsNullOrWhiteSpace(p.NumeroReferencia) ? "—" : p.NumeroReferencia)</td>
                                            <td class="text-end">Q @p.MontoPagado.ToString("N2")</td>
                                            <td class="text-end">
                                                @if (!string.IsNullOrWhiteSpace(p.ComprobantePath))
                                                {
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <a class="btn btn-outline-primary js-comprobante"
                                                           href="@Url.Action("ComprobanteParcial", "Pagos", new { pagoId = p.PagoReservaID })"
                                                           data-target="#comprobantePago"
                                                           title="Ver comprobante">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a asp-action="DescargarComprobante"
                                                           asp-controller="Pagos"
                                                           asp-route-pagoId="@p.PagoReservaID"
                                                           class="btn btn-outline-secondary"
                                                           title="Descargar comprobante">
                                                            <i class="bi bi-download"></i>
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div id="comprobantePago">
                        @await Html.PartialAsync("_ComprobantePago", sel)
                    </div>
                </div>

                <!-- Columna derecha: PDF de reserva -->
                <div class="col-12 col-lg-6">
                    <h6 class="pc-subtitle">Comprobante de reservación (PDF)</h6>

                    <div class="preview-box">
                        <embed src="@($"{verPdfReserva}#toolbar=1&navpanes=0")"
                               type="application/pdf"
                               width="100%"
                               style="height:520px;border-radius:.5rem;" />

                        <div class="preview-actions">
                            <a class="btn btn-outline-secondary btn-sm"
                               href="@verPdfReserva"
                               target="_blank" rel="noopener">
                                <i class="bi bi-box-arrow-up-right"></i> Abrir en pestaña
                            </a>
                            <a class="btn btn-outline-secondary btn-sm"
                               href="@Url.Action("ReservaPdf", "Reservas", new { id = r.ReservaID, descargar = true })">
                                <i class="bi bi-download"></i> Descargar PDF
                            </a>
                        </div>
                    </div>

                    <div class="mt-3 text-muted small">
                        <i class="bi bi-info-circle"></i>
                        Desde este panel puedes revisar el documento de reserva con el desglose de impuestos
                        y todos los términos y condiciones configurados.
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ===== Flash Modal (notificación tras registrar pago) ===== *@
    @{
        var flashMsg = TempData["FlashModal"] as string;
        var flashType = (TempData["FlashType"] as string ?? "info").ToLower();
    }
    @if (!string.IsNullOrWhiteSpace(flashMsg))
    {
        <div class="flash-mask" id="flashMask" aria-hidden="true">
            <div class="flash-card">
                <div class="flash-head @(flashType == "success" ? "flash-ok" : flashType == "warning" ? "flash-warn" : flashType == "danger" ? "flash-error" : "flash-info")">
                    Notificación
                </div>
                <div class="flash-body">
                    @flashMsg
                </div>
            </div>
        </div>

        <script>
            (function(){
              const mask = document.getElementById('flashMask');
              if (!mask) return;
              mask.style.display = 'flex';
              setTimeout(()=>{ mask.style.display = 'none'; }, 2500);
              mask.addEventListener('click', (e)=>{ if (e.target === mask) mask.style.display='none'; });
            })();
        </script>
    }
</div>

<script>
    // Carga de comprobante parcial por AJAX
    document.addEventListener('click', async (ev) => {
      const a = ev.target.closest('a.js-comprobante');
      if (!a) return;
      ev.preventDefault();

      const url = a.getAttribute('href');
      const targetSel = a.dataset.target || '#comprobantePago';
      const target = document.querySelector(targetSel);
      if (!target) return;

      try {
        const r = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const html = await r.text();
        target.innerHTML = html;

        // Marca la fila seleccionada
        const tr = a.closest('tr');
        document.querySelectorAll('tbody tr').forEach(x => x.classList.remove('table-primary'));
        if (tr) tr.classList.add('table-primary');
      } catch (e) {
        console.error(e);
      }
    });
</script>

@* @model PIOGHOASIS.Models.PagoReserva
@{
    Layout = null;

    var r = Model.Reserva;
    decimal pagado = ViewBag.Pagado ?? 0m;
    decimal pendiente = ViewBag.Pendiente ?? 0m;

    var volverUrl = Url.Action("Index", "Reservas");
    var descargarUrl = Url.Action("DescargarComprobante", "Pagos", new { pagoId = Model.PagoReservaID });

    bool isImg = !string.IsNullOrWhiteSpace(Model.ComprobanteMime) && Model.ComprobanteMime.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    bool isPdf = !string.IsNullOrWhiteSpace(Model.ComprobanteMime) && Model.ComprobanteMime.Contains("pdf", StringComparison.OrdinalIgnoreCase);
    bool hasFile = !string.IsNullOrWhiteSpace(Model.ComprobantePath);
}

<style>
    /* ====== LAYOUT (igual a Nueva.cshtml) ====== */
    .pay-create {
        position: relative;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        padding: 24px;
        background: linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,.30)),url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        background-attachment: fixed;
        background-position: center center;
        background-size: cover;
    }

    .pc-back {
        position: sticky;
        top: calc(var(--header-h) + 8px);
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: #4b5563;
        color: #fff;
        border: none;
        border-radius: .5rem;
        padding: .4rem .75rem;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0,0,0,.15)
    }

        .pc-back:hover {
            filter: brightness(.95);
            color: #fff
        }

    .pc-card {
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(2px)
    }

    .pc-header {
        background: #f0a100;
        color: #1f2a37;
        font-weight: 800;
        padding: .75rem 1rem;
        border-top-left-radius: .75rem;
        border-top-right-radius: .75rem;
        border-bottom: 2px solid #d7a536;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px
    }

    .pc-subtitle {
        font-weight: 800;
        color: #1f2a37;
        border-left: 4px solid #f0a100;
        padding-left: .5rem;
        margin: .25rem 0 1rem;
    }

    .badge-soft {
        display: inline-block;
        padding: .2rem .5rem;
        border-radius: 999px;
        background: #eef2ff;
        border: 1px solid #e5e7eb;
        font-weight: 700
    }

    .kv {
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 8px 12px
    }

        .kv .k {
            font-weight: 700;
            color: #1f2a37
        }

    .preview-box {
        background: #fff;
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        padding: 10px
    }

        .preview-box img {
            max-width: 100%;
            height: auto;
            border-radius: .5rem;
            display: block
        }

    .preview-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
        margin-top: 8px
    }
</style>

<div class="pay-create">
    <div class="d-flex justify-content-end mb-2">
        <a class="pc-back ajax-nav" href="/Home/Dashboard" data-url="@volverUrl">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>

    <div class="pc-card">
        <div class="pc-header">
            <div>
                <div class="h6 mb-0">Detalle de Pago</div>
                <small class="text-muted">
                    Reserva @r?.Codigo · @r?.Cliente?.Persona?.PrimerNombre @r?.Cliente?.Persona?.PrimerApellido
                </small>
            </div>
            <div class="text-end small">
                <div>Pagado: <strong>Q @pagado.ToString("N2")</strong></div>
                <div>Pendiente: <span class="badge-soft">Q @pendiente.ToString("N2")</span></div>
            </div>
        </div>

        <div class="p-3 p-md-4">
            <div class="row g-3">
                <!-- Col izquierda: datos del pago -->
                <div class="col-12 col-lg-6">
                    <h6 class="pc-subtitle">Información del pago</h6>
                    <div class="kv">
                        <div class="k">Fecha de pago</div><div>@Model.FechaPago:dd/MM/yyyy</div>
                        <div class="k">Forma</div><div>@Model.FormaPago?.Nombre</div>
                        <div class="k">Tipo</div><div>@Model.TipoPago?.Nombre</div>
                        <div class="k">Plataforma</div><div>@(Model.Plataforma?.Nombre ?? "(No aplica)")</div>
                        <div class="k">Referencia</div><div>@(string.IsNullOrWhiteSpace(Model.NumeroReferencia) ? "(No aplica)" : Model.NumeroReferencia)</div>
                        <div class="k">Monto</div><div><strong>Q @Model.MontoPagado.ToString("N2")</strong></div>
                        <div class="k">Observaciones</div><div>@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "—" : Model.Observaciones)</div>
                    </div>

                    <hr class="my-3" />
                    <div class="kv">
                        <div class="k">Reserva</div><div>@r?.Codigo</div>
                        <div class="k">Fechas</div><div>@r?.FechaCheckIn:dd/MM/yyyy — @r?.FechaCheckOut:dd/MM/yyyy</div>
                        <div class="k">Total reserva</div><div>Q @r?.Total.ToString("N2")</div>
                        <div class="k">Estado</div><div>@r?.Estado?.Nombre</div>
                    </div>
                </div>

                <!-- Col derecha: comprobante -->
                <div class="col-12 col-lg-6">
                    <h6 class="pc-subtitle">Comprobante</h6>

                    @if (hasFile)
                    {
                        <div class="preview-box">
                            @if (isImg)
                            {
                                <img src="@Model.ComprobantePath" alt="Comprobante" />
                            }
                            else if (isPdf)
                            {
                                <embed src="@($"{Model.ComprobantePath}#toolbar=1&navpanes=0")"
                                       type="application/pdf" width="100%" style="height:520px;border-radius:.5rem;" />
                            }
                            else
                            {
                                <div class="text-muted">Archivo adjunto: @Model.ComprobanteNombre</div>
                            }

                            <div class="preview-actions">
                                <a class="btn btn-outline-secondary btn-sm" href="@Model.ComprobantePath" target="_blank" rel="noopener">
                                    <i class="bi bi-box-arrow-up-right"></i> Abrir
                                </a>
                                <a class="btn btn-primary btn-sm" href="@descargarUrl">
                                    <i class="bi bi-download"></i> Descargar
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No se adjuntó comprobante.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
 *@
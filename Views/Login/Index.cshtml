@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" />

    <style>
        /* Overlay de carga global */
        #globalLoader {
            position: fixed;
            inset: 0;
            z-index: 1049; /* debajo de backdrop/modal (1050/1055) */
            background: rgba(0,0,0,.35);
            backdrop-filter: blur(1px);
            display: grid;
            place-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity .15s ease;
        }

            #globalLoader.show {
                opacity: 1;
                pointer-events: auto;
            }

            #globalLoader .gl-card {
                background: rgba(255,255,255,.95);
                border-radius: .75rem;
                padding: 18px 20px;
                min-width: 130px;
                text-align: center;
                box-shadow: 0 10px 30px rgba(0,0,0,.2);
            }
        @@media (prefers-reduced-motion: reduce) {
            #globalLoader

        {
            transition: none;
        }

        }
    </style>


</head>
<body>
    <div class="login-shell">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10">
                    <div class="card-glass">
                        <div class="row g-0 align-items-stretch">

                            <!-- Columna izquierda: logo -->
                            <div class="col-12 col-md-5 position-relative brand-box">
                                <img src="/img/login/logo-oasis.png" alt="Hotel Oasis Logo">
                                <span class="v-divider" aria-hidden="true"></span>
                            </div>

                            <!-- Columna derecha: formulario -->
                            <div class="col-12 col-md-7 form-side">
                                <h5 class="title">Sistema Web de Gestión</h5>
                                <h5 class="subtitle">y Operación Hotelera</h5>

                                <!-- Mensajes (opcional) -->
                                @if(TempData["LoginMessage"] != null){
                                    <div class="alert alert-warning py-2" role="alert">
                                        @TempData["LoginMessage"]
                                    </div>
                                }

                                @if (TempData["MsgOk"] is string ok)
                                {
                                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                                        @ok
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                }

                                <form method="post" action="/Login/Index" autocomplete="off">
                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">
                                        <label for="Usuario" class="form-label">Usuario</label>
                                        <input type="text" id="Usuario" name="Usuario"
                                               class="form-control oasis-input" placeholder="Usuario" required />
                                    </div>

                                    <div class="mb-2">
                                        <label for="Contrasena" class="form-label">Contraseña</label>
                                        <input type="password" id="Contrasena" name="Contrasena"
                                               class="form-control oasis-input" placeholder="••••••••" required />
                                    </div>

                                    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center 
                                    gap-3 mt-4 area_btn_ingresar justify-content-center">
                                        <button type="submit" class="btn btn-oasis">
                                            Ingresar
                                        </button>
                                    </div>
                                    <div class="area_link_contraseña">
                                        <a class="help-link" href="/Password/Forgot">
                                            ¿Olvidaste tu contraseña?
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Espaciado inferior en móviles para no chocar con la barra -->
                    <div class="py-2"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loader global -->
    <div id="globalLoader" aria-hidden="true">
        <div class="gl-card">
            <div class="spinner-border" role="status" aria-label="Cargando..."></div>
            <div class="mt-2 small">Validando…</div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function(){
          // anti-parpadeo
          let showTimer = null;
          const $loader = () => document.getElementById('globalLoader');
          const showLoader = () => {
            clearTimeout(showTimer);
            showTimer = setTimeout(() => $loader()?.classList.add('show'), 120);
          };
          const hideLoader = () => {
            clearTimeout(showTimer);
            $loader()?.classList.remove('show');
          };

          // 1) Mostrar mientras se valida el login
          const form = document.querySelector('form[action="/Login/Index"]');
          if (form){
            form.addEventListener('submit', () => {
              // deshabilita botón y muestra spinner en el botón
              const btn = form.querySelector('button[type="submit"]');
              if (btn && !btn.dataset.loading){
                btn.dataset.loading = "1";
                btn.disabled = true;
                btn.insertAdjacentHTML('afterbegin',
                  '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>');
              }
              showLoader();
            });
          }

          // 2) Mostrar loader en cualquier navegación saliente (por ejemplo redirección después del POST)
          window.addEventListener('beforeunload', showLoader);

          // 3) Si el navegador vuelve desde bfcache (atrás/adelante), oculta el loader
          window.addEventListener('pageshow', (e) => {
            if (e.persisted) hideLoader();
          });
        })();
    </script>


</body>
</html>

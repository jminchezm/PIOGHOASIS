<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>


<div class="hab-create">
    <div class="d-flex justify-content-end mb-2">
        <a class="hc-back ajax-nav" href="/Home/Dashboard" data-url="@volverUrl">
            <i class="bi bi-arrow-left"></i> Volver a reservas
        </a>
    </div>

    <div class="hc-card">
        <div class="hc-header">Datos del cliente</div>

        <div class="p-3 p-md-4">
            <div class="flow-wrap">
                <div class="flow-grid">

                    <!-- === Col izquierda: Cliente (SIN CAMBIOS) === -->
                    <div class="card-ish">
                        <div class="sec">
                            <div class="sec-title">Información del Cliente</div>

                            <form id="frmCliente" method="post" asp-action="Cliente" class="vstack gap-3">
                                @Html.AntiForgeryToken()

                                <!-- Campo de búsqueda grande con icons -->
                                <div>
                                    <div class="ta-wrap ta-big">
                                        <i class="bi bi-search ta-icon"></i>

                                        <input id="clienteSearch" class="form-control ta-input" type="text"
                                               placeholder="Escribe nombre o DPI…" autocomplete="off" />

                                        <!-- Panel de resultados -->
                                        <div id="clientePanel" class="ta-panel"></div>

                                        <!-- Valor real para POST -->
                                        <input type="hidden" name="clienteId" id="clienteId" required />

                                        <i class="bi bi-chevron-down ta-caret"></i>
                                    </div>
                                    <small class="text-muted">Escribe al menos 2 caracteres para buscar.</small>
                                </div>

                                <!-- Botones -->
                                <div class="d-flex gap-2 pt-1">
                                    <a id="btnNuevoCliente" class="btn btn-success" href="#">
                                        <i class="bi bi-person-plus"></i> Nuevo
                                    </a>
                                    <button id="btnContinuar" class="btn-accent" disabled>Continuar</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- === Col derecha: Resumen (SIN CAMBIOS) === -->
                    <aside class="card-ish summary">
                        @await Html.PartialAsync("_ResumenReservaSidebar", Model.Resumen)
                    </aside>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal crear cliente inline -->
<div class="modal fade" id="cliInlineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Nuevo cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div id="cliInlineBody" class="p-3">
                    <div class="text-muted small">Cargando formulario…</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast simple (opcional) -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
    <div id="cliToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">¡Cliente creado exitosamente!</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    (function () {
      const $btnNuevo = document.getElementById('btnNuevoCliente');
      const $modalEl  = document.getElementById('cliInlineModal');
      const modal     = $modalEl ? new bootstrap.Modal($modalEl) : null;
      const $body     = document.getElementById('cliInlineBody');

      $btnNuevo?.addEventListener('click', async (ev) => {
        ev.preventDefault();
        if (!modal || !$body) return;
        $body.innerHTML = '<div class="p-3 text-muted small">Cargando formulario…</div>';
        modal.show();

        try {
          const r = await fetch('/Clientes/CreateInline', {
            headers: { 'X-Requested-With':'XMLHttpRequest' },
            cache: 'no-store'
          });
          const html = await r.text();
          $body.innerHTML = html;

          // Reparse unobtrusive en el nuevo HTML
          if (window.jQuery && window.jQuery.validator) {
            window.jQuery.validator.unobtrusive.parse($body);
          }

          initCascadaUbicacion($body);
          wireInlineForm($body);   // <<-- IMPORTANTE
        } catch(e) {
          $body.innerHTML = '<div class="p-3 text-danger">No se pudo cargar el formulario.</div>';
        }
      });

      function wireInlineForm(root){
        const form = root.querySelector('#cliInlineForm');
        if (!form || form.dataset.wired === '1') return;
        form.dataset.wired = '1';

        async function ajaxSubmit(formEl){
          const fd    = new FormData(formEl);
          const token = formEl.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

          const resp = await fetch(formEl.action, {
            method: 'POST',
            headers: { 'X-Requested-With':'XMLHttpRequest', 'RequestVerificationToken': token },
            body: fd
          });

          const ct = resp.headers.get('content-type') || '';
          if (ct.includes('application/json')) {
            const data = await resp.json();
            if (data?.ok) {
              window.dispatchEvent(new CustomEvent('cliente:creado', { detail: data }));
              modal?.hide();
              return;
            }
          }

          // Volvió partial con errores → reinyectar y re-cablear
          const html = await resp.text();
          const host = document.getElementById('cliInlineBody');
          host.innerHTML = html;
          if (window.jQuery && window.jQuery.validator) {
            window.jQuery.validator.unobtrusive.parse(host);
          }
          initCascadaUbicacion(host);
          wireInlineForm(host);
        }

        // 1) Intercepta el submit del form
        form.addEventListener('submit', function(e){
          e.preventDefault();
          e.stopImmediatePropagation();  // evita que otros handlers sigan
          if (window.jQuery) {
            const $f = window.jQuery(form);
            if ($f.data('validator') && !$f.valid()) return; // deja que muestre errores
          }
          ajaxSubmit(form);
        }, true); // capture = true para ir ANTES que jQuery

        // 2) Si jQuery Validate está presente, anula su auto-submit nativo
        if (window.jQuery) {
          const $f = window.jQuery(form);
          const v  = $f.data('validator');
          if (v) {
            v.settings.submitHandler = function(formEl){
              ajaxSubmit(formEl);
              return false; // <- evita form.submit() nativo de jQuery Validate
            };
          }
        }
      }

      // … tu initCascadaUbicacion(root) se queda igual …
      function initCascadaUbicacion(root) {
        const pais = root.querySelector('#Inline_Pais');
        const dep  = root.querySelector('#Inline_Departamento');
        const mun  = root.querySelector('#Inline_Municipio');
        if (!pais || !dep || !mun) return;
        const off = (el)=>{ el.value=''; el.innerHTML='<option value="">Seleccione...</option>'; el.setAttribute('disabled','disabled'); };
        const on  = (el)=>{ el.removeAttribute('disabled'); };
        pais.addEventListener('change', async () => {
          const v = (pais.value || '').trim().toUpperCase();
          off(dep); off(mun);
          if (v !== 'GTM') return;
          on(dep);
          dep.innerHTML = '<option value="">Cargando...</option>';
          const r = await fetch('/Clientes/Departamentos?paisId=' + encodeURIComponent(v), { headers:{'X-Requested-With':'XMLHttpRequest'}});
          const arr = await r.json();
          dep.innerHTML = '<option value="">Seleccione...</option>';
          arr.forEach(x => { const o=document.createElement('option'); o.value=x.id; o.textContent=x.nombre; dep.appendChild(o); });
        });
        dep.addEventListener('change', async () => {
          const id = parseInt(dep.value || '0', 10);
          off(mun); if (!id) return; on(mun);
          mun.innerHTML = '<option value="">Cargando...</option>';
          const r = await fetch('/Clientes/Municipios?deptoId=' + id, { headers:{'X-Requested-With':'XMLHttpRequest'}});
          const arr = await r.json();
          mun.innerHTML = '<option value="">Seleccione...</option>';
          arr.forEach(x => { const o=document.createElement('option'); o.value=x.id; o.textContent=x.nombre; mun.appendChild(o); });
        });
      }

      // Toast de éxito (igual que ya tenías)
      window.addEventListener('cliente:creado', (ev) => {
        const d   = ev.detail || {};
        const txt = [d.nombre, d.dpi ? ('• ' + d.dpi) : ''].join(' ').trim();
        const input = document.getElementById('clienteSearch');
        const id    = document.getElementById('clienteId');
        const btnGo = document.getElementById('btnContinuar');
        if (input) input.value = txt;
        if (id)    id.value    = d.id || '';
        if (btnGo) btnGo.disabled = !d.id;
        const t = document.getElementById('cliToast');
        if (t) new bootstrap.Toast(t).show();
      });
    })();
</script>




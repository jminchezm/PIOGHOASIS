@model PIOGHOASIS.Models.ViewModels.ReservaCreateVM
@{
    Layout = null;
    ViewData["Title"] = "Datos del cliente";

    var volverUrl = Url.Action("ElegirHabitacion", "Reservas", new
    {
        checkIn = Model.Resumen.CheckIn.ToString("yyyy-MM-dd"),
        checkOut = Model.Resumen.CheckOut.ToString("yyyy-MM-dd"),
        personas = Model.Resumen.Personas
    });
}

<style>
    /* ===== Layout estilo Habitaciones/Create ===== */
    .hab-create {
        position: relative;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        padding: 24px;
        background: linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,.30)),url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        background-attachment: fixed;
        background-position: center center;
        background-size: cover;
    }

    .hc-card {
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(2px)
    }

    .hc-header {
        background: #f0a100;
        color: #1f2a37;
        font-weight: 800;
        padding: .75rem 1rem;
        border-top-left-radius: .75rem;
        border-top-right-radius: .75rem;
        border-bottom: 2px solid #d7a536;
    }

    .hc-back {
        position: sticky;
        top: calc(var(--header-h) + 8px);
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: #4b5563;
        color: #fff;
        border: none;
        border-radius: .5rem;
        padding: .4rem .75rem;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0,0,0,.15)
    }

        .hc-back:hover {
            filter: brightness(.95);
            color: #fff
        }

    .form-label {
        font-weight: 700;
        color: #1f2a37
    }

    .pc-subtitle {
        font-weight: 800;
        color: #1f2a37;
        border-left: 4px solid #f0a100;
        padding-left: .5rem;
        margin: .25rem 0 1rem;
    }

    /* ===== Typeahead (respeta tus clases internas) ===== */
    .ta-wrap {
        position: relative
    }

    .ta-input {
        height: 46px;
        padding-left: 44px;
        padding-right: 42px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 0 rgba(0,0,0,.02);
    }

        .ta-input:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(59,130,246,.15)
        }

    .ta-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        opacity: .55;
        font-size: 18px
    }

    .ta-caret {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        opacity: .55;
        font-size: 16px
    }

    .ta-panel {
        position: absolute;
        z-index: 50;
        left: 0;
        right: 0;
        top: calc(100% + 6px);
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0,0,0,.10);
        max-height: 320px;
        overflow: auto;
        display: none;
    }

    .ta-item {
        padding: 12px 14px;
        cursor: pointer;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center
    }

        .ta-item + .ta-item {
            border-top: 1px dashed #f1f5f9
        }

        .ta-item:hover, .ta-item.active {
            background: #f8fafc
        }

    .ta-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: .9rem;
        background: linear-gradient(180deg,#dbeafe,#bfdbfe);
        color: #1e3a8a;
        border: 1px solid #dbeafe
    }

    .ta-name {
        font-weight: 800;
        color: #0f172a;
        line-height: 1.1
    }

    .ta-sub {
        color: #6b7280;
        font-size: .85rem
    }

    .ta-id {
        color: #94a3b8;
        font-size: .8rem;
        font-weight: 700
    }

    .ta-empty {
        padding: 14px;
        color: #6b7280
    }

    /* ===== Botones ===== */
    .btn-accent {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 800;
        box-shadow: 0 10px 20px rgba(37,99,235,.15)
    }

        .btn-accent:hover {
            filter: brightness(.97);
            color: #fff
        }

    .btn-success {
        border-radius: 12px;
        font-weight: 800;
        box-shadow: 0 10px 20px rgba(22,163,74,.12)
    }

    /* ===== Mantén tus cards/summary como antes ===== */
    .flow-wrap {
        max-width: 1200px;
        margin: 24px auto;
        padding: 0 16px
    }

    .flow-grid {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 24px
    }
    @@media (max-width: 992px) {
        .flow-grid

    {
        grid-template-columns: 1fr
    }

    }

    .card-ish {
        background: rgba(255,255,255,.9);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .85rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(2px);
    }

    .sec {
        padding: 22px 22px 18px;
    }

    .sec-title {
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: .75rem;
    }

    .pc-back {
        position: sticky;
        top: 16px;
        left: 16px;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: #4b5563;
        color: #fff !important;
        border: none;
        border-radius: .6rem;
        padding: .5rem .9rem;
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(0,0,0,.18);
        font-weight: 700;
        margin-top: 15px;
        margin-left: 50px;
    }

        .pc-back:hover {
            filter: brightness(.95);
            color: #fff !important;
        }

    .confirm-box .rowline {
        display: flex;
        gap: 10px;
        margin: .35rem 0;
    }

    .muted {
        color: #6b7280;
    }

    .btn-accent {
        background: #1f6aff;
        color: #fff;
        border: none;
        border-radius: .65rem;
        padding: 12px 18px;
        font-weight: 800;
    }

    /* --- Summary (mismos estilos que en Cliente) --- */
    .summary {
        position: sticky;
        top: 20px;
        padding: 18px;
    }

        .summary .title {
            font-weight: 800;
            font-size: 1.15rem;
            margin-bottom: .35rem;
        }

        .summary .dates {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }

        .summary .badge-night {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #eef2ff;
            color: #1f2937;
            border: 1px solid #e5e7eb;
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 700;
        }

        .summary hr {
            margin: 12px 0;
        }

        .summary .rowline {
            display: flex;
            justify-content: space-between;
            margin: 6px 0;
        }

        .summary .total {
            font-size: 1.25rem;
            font-weight: 800;
        }
</style>

<div class="hab-create">
    <div class="d-flex justify-content-end mb-2">
        <a class="hc-back ajax-nav" href="/Home/Dashboard" data-url="@volverUrl">
            <i class="bi bi-arrow-left"></i> Volver a reservas
        </a>
    </div>

    <div class="hc-card">
        <div class="hc-header">Datos del cliente</div>

        <div class="p-3 p-md-4">
            <div class="flow-wrap">
                <div class="flow-grid">

                    <!-- === Col izquierda: Cliente (SIN CAMBIOS) === -->
                    <div class="card-ish">
                        <div class="sec">
                            <div class="sec-title">Información del Cliente</div>

                            <form id="frmCliente" method="post" asp-action="Cliente" class="vstack gap-3">
                                @Html.AntiForgeryToken()

                                <!-- Campo de búsqueda grande con icons -->
                                <div>
                                    <div class="ta-wrap ta-big">
                                        <i class="bi bi-search ta-icon"></i>

                                        <input id="clienteSearch" class="form-control ta-input" type="text"
                                               placeholder="Escribe nombre o DPI…" autocomplete="off" />

                                        <!-- Panel de resultados -->
                                        <div id="clientePanel" class="ta-panel"></div>

                                        <!-- Valor real para POST -->
                                        <input type="hidden" name="clienteId" id="clienteId" required />

                                        <i class="bi bi-chevron-down ta-caret"></i>
                                    </div>
                                    <small class="text-muted">Escribe al menos 2 caracteres para buscar.</small>
                                </div>

                                <div class="d-flex gap-2 pt-1">
                                    <a class="btn btn-success" href="/Clientes/Create" target="_blank">
                                        <i class="bi bi-person-plus"></i> Nuevo
                                    </a>
                                    <button id="btnContinuar" class="btn-accent">Continuar</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- === Col derecha: Resumen (SIN CAMBIOS) === -->
                    <aside class="card-ish summary">
                        @await Html.PartialAsync("_ResumenReservaSidebar", Model.Resumen)
                    </aside>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
      const $input  = document.getElementById('clienteSearch');
      const $panel  = document.getElementById('clientePanel');
      const $id     = document.getElementById('clienteId');
      const $btn    = document.getElementById('btnContinuar');

      let timer = null, idx = -1, results = [];

      const showPanel = () => $panel.style.display = 'block';
      const hidePanel = () => { $panel.style.display = 'none'; idx = -1; };
      const enableSubmit = ok => { if ($btn) $btn.disabled = !ok; };

      const initials = (name) => {
        if (!name) return '??';
        const p = name.trim().split(/\s+/);
        const a = p[0]?.charAt(0) ?? '';
        const b = p.length > 1 ? p[p.length-1].charAt(0) : '';
        return (a + b).toUpperCase();
      };

      function renderList(items){
        results = items || [];
        idx = -1;

        if (!items || items.length === 0){
          $panel.innerHTML = '<div class="ta-empty">Sin resultados</div>';
          showPanel();
          return;
        }

        $panel.innerHTML = items.map((x,i)=>`
          <div class="ta-item" data-ix="${i}">
            <div class="ta-avatar">${initials(x.nombre)}</div>
            <div>
              <div class="ta-name">${x.nombre ?? '(Sin nombre)'}</div>
              <div class="ta-sub">
                ${x.dpi ? 'DPI: ' + x.dpi : 'Sin DPI'}
                ${x.telefono ? ' • ' + x.telefono : ''}
                ${x.correo ? ' • ' + x.correo : ''}
              </div>
            </div>
            <div class="ta-id">${x.id}</div>
          </div>
        `).join('');
        showPanel();
      }

      function pick(i){
        const it = results[i];
        if (!it) return;
        $input.value = `${it.nombre}${it.dpi ? ' • ' + it.dpi : ''}`;
        $id.value = it.id;
        enableSubmit(true);
        hidePanel();
      }

      async function search(q){
        q = (q || '').trim();
        if (q.length < 2){ hidePanel(); enableSubmit(false); $id.value = ''; return; }

        try{
          const url = `/Reservas/BuscarClientes?q=${encodeURIComponent(q)}&_=${Date.now()}`;
          const r = await fetch(url, { headers:{ 'X-Requested-With':'XMLHttpRequest' } });
          if (!r.ok) throw new Error('HTTP ' + r.status);
          const data = await r.json();
          renderList(data);
        }catch(e){
          console.error(e);
          renderList([]);
        }
      }

      $input.addEventListener('input', () => {
        enableSubmit(false);
        $id.value = '';
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => search($input.value), 250);
      });

      $input.addEventListener('keydown', (ev) => {
        const items = Array.from($panel.querySelectorAll('.ta-item'));
        if (!items.length) return;

        if (ev.key === 'ArrowDown'){
          ev.preventDefault();
          idx = Math.min(idx + 1, items.length - 1);
        } else if (ev.key === 'ArrowUp'){
          ev.preventDefault();
          idx = Math.max(idx - 1, 0);
        } else if (ev.key === 'Enter'){
          if (idx >= 0){ ev.preventDefault(); pick(idx); }
          return;
        } else if (ev.key === 'Escape'){
          hidePanel(); return;
        } else return;

        items.forEach((el,i)=> el.classList.toggle('active', i===idx));
        if (idx >= 0) items[idx].scrollIntoView({ block:'nearest' });
      });

      $panel.addEventListener('click', (ev) => {
        const el = ev.target.closest('.ta-item');
        if (!el) return;
        pick(parseInt(el.dataset.ix || '-1', 10));
      });

      document.addEventListener('click', (ev) => {
        if (!ev.target.closest('.ta-wrap')) hidePanel();
      });
    })();
</script>







@model PIOGHOASIS.Models.ViewModels.ReservaResumenVM
@{
    Layout = null;
    ViewData["Title"] = "Confirmar reserva";

    // URL para navegar de vuelta (mismo patrón que Cliente.cshtml)
    var backAjaxUrl = Url.Action("Cliente", "Reservas");
}

<style>
    /* ===== Layout estilo Habitaciones/Create (igual a Cliente.cshtml) ===== */
    .hab-create {
        position: relative;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        padding: 24px;
        background: linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,.30)),url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        background-attachment: fixed;
        background-position: center center;
        background-size: cover;
    }

    .hc-card {
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(2px)
    }

    .hc-header {
        background: #f0a100;
        color: #1f2a37;
        font-weight: 800;
        padding: .75rem 1rem;
        border-top-left-radius: .75rem;
        border-top-right-radius: .75rem;
        border-bottom: 2px solid #d7a536;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

        .hc-header small {
            font-weight: 600;
            color: #78350f;
        }

    .hc-back {
        position: sticky;
        top: calc(var(--header-h) + 8px);
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: #4b5563;
        color: #fff;
        border: none;
        border-radius: .5rem;
        padding: .4rem .75rem;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0,0,0,.15)
    }

        .hc-back:hover {
            filter: brightness(.95);
            color: #fff
        }

    /* Grilla / cards como en Cliente.cshtml */
    .flow-wrap {
        max-width: 1200px;
        margin: 24px auto;
        padding: 0 16px
    }

    .flow-grid {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 24px
    }

    @@media (max-width: 992px) {
        .flow-grid {
            grid-template-columns: 1fr;
        }
    }

    .card-ish {
        background: rgba(255,255,255,.9);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .85rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(2px);
    }

    .sec {
        padding: 22px 22px 18px
    }

    .sec-title {
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: .35rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .sec-title i {
            font-size: 1.1rem;
            color: #2563eb;
        }

    .sec-subtitle {
        font-size: .9rem;
        color: #6b7280;
        margin-bottom: .75rem;
    }

    /* Bloque de datos principales */
    .confirm-info {
        background: #f9fafb;
        border-radius: .75rem;
        padding: 12px 14px;
        border: 1px solid #e5e7eb;
        margin-bottom: 14px;
    }

    .confirm-info-grid {
        display: grid;
        grid-template-columns: 1.2fr 1.1fr;
        gap: 6px 18px;
        font-size: .9rem;
    }

    @@media (max-width: 576px) {
        .confirm-info-grid {
            grid-template-columns: 1fr;
        }
    }

    .confirm-info-label {
        font-weight: 700;
        color: #374151;
    }

    .pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 6px;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .8rem;
        border: 1px solid #e5e7eb;
        background: #eff6ff;
        color: #1f2937;
        font-weight: 600;
    }

        .pill i {
            font-size: .9rem;
            opacity: .7;
        }

    /* Lista de habitaciones / precios */
    .sec-block-title {
        font-size: .95rem;
        font-weight: 700;
        margin: 10px 0 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .sec-block-title span.badge {
            font-size: .75rem;
            border-radius: 999px;
            background: #e5e7eb;
            color: #374151;
        }

    .room-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 4px;
    }

    .room-card {
        border-radius: .75rem;
        border: 1px solid #e5e7eb;
        background: #f9fafb;
        padding: 10px 12px;
        position: relative;
    }

        .room-card.highlight {
            background: #eef2ff;
            border-color: #c7d2fe;
        }

    .room-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    .room-title {
        font-weight: 700;
        font-size: .96rem;
    }

    .room-meta {
        font-size: .8rem;
        color: #6b7280;
    }

    .badge-discount {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: .7rem;
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
        font-weight: 700;
    }

        .badge-discount i {
            font-size: .9rem;
        }

    .room-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: .85rem;
    }

    .rowline {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin: .35rem 0;
        font-size: .85rem;
    }

        .rowline small {
            font-size: .78rem;
        }

        .rowline label {
            margin: 0;
        }

    .muted {
        color: #6b7280
    }

    /* Input precio acordado */
    .price-input-group {
        max-width: 210px;
    }

        .price-input-group .input-group-text {
            background: #f3f4f6;
            border-right: 0;
        }

        .price-input-group .form-control {
            border-left: 0;
            font-weight: 600;
        }

            .price-input-group .form-control:focus {
                box-shadow: none;
                border-color: #2563eb;
            }

    .line-total-label {
        font-weight: 600;
    }

    .line-total-value {
        font-weight: 800;
        font-size: .95rem;
    }

    /* Botón primario consistente */
    .btn-accent {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 800;
        box-shadow: 0 10px 20px rgba(37,99,235,.15);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-accent:hover {
            filter: brightness(.97);
            color: #fff
        }

    /* --- Summary (mismos estilos que en Cliente) --- */
    .summary {
        position: sticky;
        top: 20px;
        padding: 18px
    }

        .summary .title {
            font-weight: 800;
            font-size: 1.15rem;
            margin-bottom: .35rem
        }

        .summary .dates {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600
        }

        .summary .badge-night {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #eef2ff;
            color: #1f2937;
            border: 1px solid #e5e7eb;
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 700
        }

        .summary hr {
            margin: 12px 0
        }

        .summary .rowline {
            display: flex;
            justify-content: space-between;
            margin: 6px 0
        }

        .summary .total {
            font-size: 1.25rem;
            font-weight: 800
        }
</style>

<div class="hab-create">
    <div class="d-flex justify-content-end mb-2">
        <a class="hc-back ajax-nav" href="/Home/Dashboard" data-url="@backAjaxUrl">
            <i class="bi bi-arrow-left"></i> Volver a Cliente
        </a>
    </div>

    <div class="hc-card">
        <div class="hc-header">
            <span>Confirmar reserva</span>
            <small><i class="bi bi-shield-check me-1"></i>Revisa cliente, fechas y precios antes de confirmar</small>
        </div>

        <div class="p-3 p-md-4">
            <div class="flow-wrap">
                <div class="flow-grid">

                    <!-- Izquierda: Confirmación -->
                    <div class="card-ish">
                        <div class="sec">
                            <div class="sec-title">
                                <i class="bi bi-clipboard-check"></i>
                                <span>Confirmación</span>
                            </div>
                            <div class="sec-subtitle">
                                Verifica los datos del huésped y ajusta, si es necesario, el precio acordado por noche en cada habitación.
                            </div>

                            <!-- Bloque resumen cliente/fechas -->
                            <div class="confirm-info">
                                <div class="confirm-info-grid">
                                    <div>
                                        <div class="confirm-info-label">
                                            <i class="bi bi-person-circle me-1"></i>Cliente
                                        </div>
                                        <div>@Model.ClienteNombre</div>
                                    </div>
                                    <div>
                                        <div class="confirm-info-label">
                                            <i class="bi bi-calendar-event me-1"></i>Fechas
                                        </div>
                                        <div>
                                            @Model.CheckIn.ToString("dd/MM/yyyy") — @Model.CheckOut.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                    <div>
                                        <div class="confirm-info-label">
                                            <i class="bi bi-moon-stars me-1"></i>Noches
                                        </div>
                                        <div>@Model.Noches noche(s)</div>
                                    </div>
                                    <div>
                                        <div class="confirm-info-label">
                                            <i class="bi bi-door-closed me-1"></i>Habitaciones
                                        </div>
                                        <div>@Model.Lineas.Count habitación(es)</div>
                                    </div>
                                </div>

                                <div class="pill-row">
                                    <span class="pill">
                                        <i class="bi bi-people-fill"></i>
                                        @Model.Lineas.Sum(l => l.Personas) huésped(es)
                                    </span>
                                    <span class="pill">
                                        <i class="bi bi-cash-coin"></i>
                                        Total actual: Q @Model.Total.ToString("N2")
                                    </span>
                                </div>
                            </div>

                            <!-- Habitaciones -->
                            <div class="sec-block-title">
                                <span>Habitaciones y precios</span>
                                <span class="badge">@Model.Lineas.Count ítem(s)</span>
                            </div>

                            @if (!Model.Lineas.Any())
                            {
                                <div class="alert alert-warning mb-2">
                                    No hay habitaciones en el resumen. Vuelve al paso anterior.
                                </div>
                            }
                            else
                            {
                                <div class="room-list">
                                    @foreach (var l in Model.Lineas)
                                    {
                                        var tieneDescuento = l.PrecioNocheOriginal > 0 && l.PrecioNocheOriginal > l.PrecioNoche;
                                        <div class="room-card @(tieneDescuento ? "highlight" : "")">
                                            <div class="room-header">
                                                <div>
                                                    <div class="room-title">@l.HabitacionTitulo</div>
                                                    <div class="room-meta">
                                                        <i class="bi bi-people me-1"></i>@l.Personas persona(s)
                                                        ·
                                                        <i class="bi bi-moon me-1"></i>@l.Noches noche(s)
                                                    </div>
                                                </div>

                                                @if (tieneDescuento)
                                                {
                                                    <div class="badge-discount">
                                                        <i class="bi bi-tag-fill"></i>
                                                        Descuento aplicado
                                                    </div>
                                                }
                                            </div>

                                            <div class="room-body">
                                                @* Precio de lista (si existe y es distinto) *@
                                                @if (tieneDescuento)
                                                {
                                                    <div class="rowline">
                                                        <span class="text-muted small">Precio lista por noche</span>
                                                        <span class="text-muted small text-decoration-line-through">
                                                            Q @l.PrecioNocheOriginal.ToString("N2")
                                                        </span>
                                                    </div>
                                                }

                                                <div class="rowline align-items-center">
                                                    <label class="mb-0">
                                                        <span>Precio acordado por noche</span><br />
                                                        <small class="text-muted">
                                                            Con impuestos incluidos
                                                        </small>
                                                    </label>
                                                    <div class="input-group input-group-sm price-input-group">
                                                        <span class="input-group-text">Q</span>
                                                        <input type="number"
                                                               step="0.01"
                                                               min="0"
                                                               class="form-control text-end js-precio-noche"
                                                               value="@l.PrecioNoche.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                               data-habitacion-id="@l.HabitacionID" />
                                                    </div>
                                                </div>

                                                <div class="rowline">
                                                    <span class="line-total-label">Total línea</span>
                                                    <span class="line-total-value">
                                                        Q @l.Total.ToString("N2")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <form method="post" asp-action="ConfirmarPost" class="mt-3">
                                @Html.AntiForgeryToken()
                                <button class="btn-accent">
                                    <i class="bi bi-check2-circle"></i>
                                    Confirmar Reserva
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Derecha: Resumen (igual que antes) -->
                    <aside class="card-ish summary">
                        @await Html.PartialAsync("_ResumenReservaSidebar", Model)
                    </aside>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!tokenInput) return;

        let timer = null;

        function attachPrecioHandlers() {
            document.querySelectorAll('.js-precio-noche').forEach(input => {
                if (input.dataset.bound === "1") return; // evitar doble binding
                input.dataset.bound = "1";

                const handler = () => {
                    const habitacionId = input.dataset.habitacionId;
                    if (!habitacionId) return;

                    // convertir valor a número (admite coma/punto)
                    const raw = (input.value || "").replace(',', '.');
                    const val = parseFloat(raw);
                    if (isNaN(val) || val <= 0) return;

                    clearTimeout(timer);
                    timer = setTimeout(() => {
                        const fd = new FormData();
                        fd.append('habitacionId', habitacionId);
                        fd.append('precioNoche', val.toString().replace(',', '.'));

                        fetch('@Url.Action("ActualizarPrecioLinea", "Reservas")', {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': tokenInput.value
                            },
                            body: fd
                        })
                            .then(r => {
                                if (!r.ok) throw new Error('Error al recalcular resumen');
                                return r.text();
                            })
                            .then(html => {
                                const summary = document.querySelector('aside.summary');
                                if (summary) summary.innerHTML = html;
                            })
                            .catch(err => console.error(err));
                    }, 400); // pequeño debounce
                };

                input.addEventListener('change', handler);
                input.addEventListener('blur', handler);
            });
        }

        // Al cargar
        attachPrecioHandlers();
        window.attachPrecioHandlers = attachPrecioHandlers;
    })();
</script>

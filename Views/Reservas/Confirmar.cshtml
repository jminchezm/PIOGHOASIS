@model PIOGHOASIS.Models.ViewModels.ReservaResumenVM
@{
    Layout = null;
    ViewData["Title"] = "Confirmar reserva";

    // URL para navegar de vuelta (mismo patrón que Cliente.cshtml)
    var backAjaxUrl = Url.Action("Cliente", "Reservas");
}

<style>
    /* ===== Layout estilo Habitaciones/Create (igual a Cliente.cshtml) ===== */
    .hab-create {
        position: relative;
        width: 100%;
        min-height: calc(100vh - var(--header-h));
        padding: 24px;
        background: linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,.30)),url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000;
        overflow: hidden;
        background-attachment: fixed;
        background-position: center center;
        background-size: cover;
    }

    .hc-card {
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .75rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(2px)
    }

    .hc-header {
        background: #f0a100;
        color: #1f2a37;
        font-weight: 800;
        padding: .75rem 1rem;
        border-top-left-radius: .75rem;
        border-top-right-radius: .75rem;
        border-bottom: 2px solid #d7a536;
    }

    .hc-back {
        position: sticky;
        top: calc(var(--header-h) + 8px);
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: #4b5563;
        color: #fff;
        border: none;
        border-radius: .5rem;
        padding: .4rem .75rem;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(0,0,0,.15)
    }

        .hc-back:hover {
            filter: brightness(.95);
            color: #fff
        }

    /* Grilla / cards como en Cliente.cshtml */
    .flow-wrap {
        max-width: 1200px;
        margin: 24px auto;
        padding: 0 16px
    }

    .flow-grid {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 24px
    }

    @@media (max-width: 992px) {
        .flow-grid {
            grid-template-columns: 1fr;
        }
    }

    .card-ish {
        background: rgba(255,255,255,.9);
        border: 1px solid rgba(0,0,0,.06);
        border-radius: .85rem;
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
        backdrop-filter: blur(2px);
    }

    .sec {
        padding: 22px 22px 18px
    }

    .sec-title {
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: .75rem
    }

    /* Botón primario consistente */
    .btn-accent {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 800;
        box-shadow: 0 10px 20px rgba(37,99,235,.15)
    }

        .btn-accent:hover {
            filter: brightness(.97);
            color: #fff
        }

    /* --- Summary (mismos estilos que en Cliente) --- */
    .summary {
        position: sticky;
        top: 20px;
        padding: 18px
    }

        .summary .title {
            font-weight: 800;
            font-size: 1.15rem;
            margin-bottom: .35rem
        }

        .summary .dates {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600
        }

        .summary .badge-night {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #eef2ff;
            color: #1f2937;
            border: 1px solid #e5e7eb;
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 700
        }

        .summary hr {
            margin: 12px 0
        }

        .summary .rowline {
            display: flex;
            justify-content: space-between;
            margin: 6px 0
        }

        .summary .total {
            font-size: 1.25rem;
            font-weight: 800
        }

    .muted {
        color: #6b7280
    }

    .rowline {
        display: flex;
        gap: 10px;
        margin: .35rem 0
    }
</style>

<div class="hab-create">
    <div class="d-flex justify-content-end mb-2">
        <a class="hc-back ajax-nav" href="/Home/Dashboard" data-url="@backAjaxUrl">
            <i class="bi bi-arrow-left"></i> Volver a Cliente
        </a>
    </div>

    <div class="hc-card">
        <div class="hc-header">Confirmar reserva</div>

        <div class="p-3 p-md-4">
            <div class="flow-wrap">
                <div class="flow-grid">

                    <!-- Izquierda: Confirmación + edición de precio -->
                    <div class="card-ish">
                        <div class="sec">
                            <div class="sec-title">Confirmación</div>

                            <div class="rowline"><strong>Cliente:</strong> <span>@Model.ClienteNombre</span></div>
                            <div class="rowline"><strong>Habitación:</strong> <span>@Model.HabitacionTitulo</span></div>
                            <div class="rowline">
                                <strong>Fechas:</strong>
                                <span>
                                    @Model.CheckIn.ToString("dd/MM/yyyy") — @Model.CheckOut.ToString("dd/MM/yyyy")
                                    <span class="muted">(@Model.Noches noche/s)</span>
                                </span>
                            </div>

                            <hr class="my-3" />

                            <form method="post" asp-action="Confirmar" class="mt-2">
                                @Html.AntiForgeryToken()

                                <h5 class="mt-2 mb-2">Precio y totales</h5>

                                <div class="mb-2">
                                    <label class="form-label">Precio por noche (lista)</label>
                                    <input class="form-control form-control-sm"
                                           value="@Model.PrecioNocheOriginal.ToString("N2")"
                                           readonly />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">
                                        Precio por noche acordado
                                        <span class="text-muted small">(con impuestos)</span>
                                    </label>
                                    <input class="form-control form-control-sm"
                                           name="precioNoche"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           value="@($"{Model.PrecioNoche:0.00}")" />
                                    <small class="text-muted">
                                        Puedes modificar este valor si se pactó un precio diferente con el cliente.
                                    </small>
                                </div>

                                @if (Model.TieneDescuento)
                                {
                                    <div class="alert alert-info py-2 mt-2">
                                        Descuento por noche: <strong>Q @Model.DescuentoPorNoche.ToString("N2")</strong><br />
                                        Descuento total: <strong>Q @Model.DescuentoTotal.ToString("N2")</strong>
                                    </div>
                                }

                                <button class="btn-accent mt-3">
                                    <i class="bi bi-check2-circle"></i> Confirmar Reserva
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Derecha: Resumen (igual que antes) -->
                    <aside class="card-ish summary">
                        @await Html.PartialAsync("_ResumenReservaSidebar", Model)
                    </aside>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const input = document.querySelector('input[name="precioNoche"]');
        const summary = document.querySelector('aside.summary');
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        if (!input || !summary || !tokenInput) return;

        let timer = null;

        input.addEventListener('input', function () {
            const val = this.value;

            // si está vacío o cero, no molestamos al servidor
            if (!val || parseFloat(val) <= 0) return;

            clearTimeout(timer);
            timer = setTimeout(() => {
                const fd = new FormData();
                fd.append('precioNoche', val);

                fetch('@Url.Action("RecalcularResumen", "Reservas")', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': tokenInput.value
                    },
                    body: fd
                })
                    .then(r => {
                        if (!r.ok) throw new Error('Error al recalcular resumen');
                        return r.text();
                    })
                    .then(html => {
                        // Reemplaza solo el contenido del resumen
                        summary.innerHTML = html;
                    })
                    .catch(err => {
                        console.error(err);
                        // Si quieres, podrías mostrar un pequeño mensaje de error.
                    });
            }, 400); // pequeño debounce para no disparar en cada tecla
        });
    })();
</script>


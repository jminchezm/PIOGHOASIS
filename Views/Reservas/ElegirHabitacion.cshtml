@* @model PIOGHOASIS.Models.ViewModels.BusquedaHabitacionVM
@{
    Layout = null;
}
<div class="hc-card p-3">
    <h3>Elige una habitación</h3>
    <form id="frmBuscar" class="row g-3" action="/Reservas/Buscar" method="get">
        <div class="col-md-3">
            <label>Check-in</label>

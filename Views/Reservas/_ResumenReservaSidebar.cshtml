@model PIOGHOASIS.Models.ViewModels.ReservaResumenVM
@using PIOGHOASIS.Services

@{
    // Desglosar el precio por noche (que YA incluye INGUAT + IVA)
    // para todas las noches de la reserva.
    var desglose = ReservaPricingService.DesglosarDesdeTotal(Model.PrecioNoche, Model.Noches);
    var baseNeta = desglose.baseNeta;   // subtotal sin impuestos (todas las noches)
    var inguat = desglose.inguat;     // 10% INGUAT total
    var iva = desglose.iva;        // 12% IVA total
    var totalConImp = desglose.total;     // total con impuestos (todas las noches)
    var impuestosTot = inguat + iva;
}

<div class="title">Resumen de Reserva</div>

<div class="dates mb-1">
    <div>@Model.CheckIn.ToString("MMM dd, yyyy")</div>
    <div><i class="bi bi-arrow-right"></i></div>
    <div>@Model.CheckOut.ToString("MMM dd, yyyy")</div>
</div>
<div class="mb-2">
    <span class="badge-night"><i class="bi bi-moon"></i> @Model.Noches Noche(s)</span>
</div>

<hr />

<div class="d-flex align-items-start justify-content-between gap-2 mb-2">
    <div>
        <div class="fw-bold">@Model.HabitacionTitulo</div>
        <div class="text-muted small">
            @(Model.TarifaID.HasValue ? "Tarifa seleccionada" : "Tarifa estándar")
        </div>
    </div>
    <div class="text-end">
        <div class="fw-bold">Q @Model.PrecioNoche.ToString("N2")</div>
        <div class="small text-muted">por noche (c/ impuestos)</div>
    </div>
</div>

<div class="mb-2"><i class="bi bi-people"></i> @Model.Personas persona(s)</div>

<hr />

<div class="rowline">
    <span>Subtotal (sin impuestos)</span>
    <span>Q @baseNeta.ToString("N2")</span>
</div>

<div class="rowline">
    <span>INGUAT 10%</span>
    <span>Q @inguat.ToString("N2")</span>
</div>

<div class="rowline">
    <span>IVA 12%</span>
    <span>Q @iva.ToString("N2")</span>
</div>

<div class="rowline">
    <span>Impuestos totales</span>
    <span>Q @impuestosTot.ToString("N2")</span>
</div>

<div class="rowline total mt-2">
    <span>Total</span>
    <span>Q @totalConImp.ToString("N2")</span>
</div>




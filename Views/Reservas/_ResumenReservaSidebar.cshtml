@model PIOGHOASIS.Models.ViewModels.ReservaResumenVM
@using PIOGHOASIS.Services

@{
    // true = se puede quitar habitaciones y mostrar "Continuar"
    // false = solo mostrar resumen "read-only"
    var editable = (bool?)ViewData["ResumenEditable"] ?? true;
}

<style>
    /* Título dentro del sidebar */
    .rs-summary__title {
        font-weight: 800;
        font-size: 1rem;
    }

    /* Fechas debajo del título */
    .rs-summary__dates i {
        opacity: .7;
    }

    /* Card de cada habitación en el resumen */
    .rs-summary-item {
        border-radius: .5rem;
    }

    /* Línea de total por habitación un poquito más marcada */
    .rs-summary-item__total {
        font-weight: 600;
    }

    /* Botón de eliminar más compacto y circular */
    .rs-remove-btn {
        padding: 4px 8px;
        border-radius: 999px;
    }

    /* Totales generales del resumen */
    .rs-summary-totals .rowline span:first-child {
        font-size: .9rem;
    }

    .rs-summary-totals .total span:last-child {
        font-size: 1.05rem;
    }

</style>

<div class="rs-summary-header mb-2">
    <div class="rs-summary__title d-flex align-items-center justify-content-between">
        <span>Resumen de Reserva</span>

        <span class="badge bg-light text-muted fw-normal">
            <i class="bi bi-moon me-1"></i>@Model.Noches Noche(s)
        </span>
    </div>

    <div class="rs-summary__dates small text-muted d-flex align-items-center gap-2 mt-1">
        <i class="bi bi-calendar3"></i>
        <span>@Model.CheckIn.ToString("MMM dd, yyyy")</span>
        <i class="bi bi-arrow-right-short"></i>
        <span>@Model.CheckOut.ToString("MMM dd, yyyy")</span>
    </div>
</div>

<hr class="my-2" />

@if (!Model.Lineas.Any())
{
    <div class="rs-summary__empty">
        Aún no has seleccionado ninguna habitación.
    </div>
}
else
{
    foreach (var l in Model.Lineas)
    {
        var desg = ReservaPricingService.DesglosarDesdeTotal(l.PrecioNoche, l.Noches);
        var baseNeta = desg.baseNeta;
        var inguat = desg.inguat;
        var iva = desg.iva;
        var total = desg.total;

        <div class="rs-summary-item mb-3 pb-2">
            <div class="d-flex justify-content-between gap-3">
                <div>
                    <div class="fw-semibold">@l.HabitacionTitulo</div>
                    <div class="text-muted small">
                        <i class="bi bi-people me-1"></i>@l.Personas persona(s)
                        <span class="mx-1">·</span>
                        <i class="bi bi-moon me-1"></i>@l.Noches noche(s)
                    </div>
                </div>

                <div class="text-end">
                    <div class="fw-bold">Q @l.PrecioNoche.ToString("N2")</div>
                    <div class="small text-muted">por noche (c/ impuestos)</div>
                </div>
            </div>

            <div class="rowline small mt-2">
                <span>Subtotal</span>
                <span>Q @baseNeta.ToString("N2")</span>
            </div>
            <div class="rowline small">
                <span>Impuestos</span>
                <span>Q @(inguat + iva)</span>
            </div>
            <div class="rowline small rs-summary-item__total">
                <span>Total línea</span>
                <span>Q @total.ToString("N2")</span>
            </div>

            @if (editable)
            {
                <div class="text-end mt-1">
                    <form method="post"
                          asp-action="QuitarHabitacion"
                          asp-controller="Reservas"
                          class="d-inline js-quitar-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="habitacionId" value="@l.HabitacionID" />
                        <button class="btn btn-sm btn-outline-danger rs-remove-btn"
                                type="submit"
                                title="Quitar habitación">
                            <i class="bi bi-trash3"></i>
                            <span class="visually-hidden">Quitar</span>
                        </button>
                    </form>
                </div>
            }

            <hr class="mt-3 mb-0" />
        </div>
    }

    <div class="rs-summary-totals mt-2">
        <div class="rowline">
            <span>Subtotal (sin impuestos)</span>
            <span>Q @Model.Subtotal.ToString("N2")</span>
        </div>
        <div class="rowline">
            <span>Impuestos totales</span>
            <span>Q @Model.Impuestos.ToString("N2")</span>
        </div>
        <div class="rowline total mt-2">
            <span>Total</span>
            <span>Q @Model.Total.ToString("N2")</span>
        </div>
    </div>

    @if (editable)
    {
        <div class="rs-summary__footer mt-3 d-flex justify-content-end">
            <a href="@Url.Action("Cliente", "Reservas")"
               data-url="@Url.Action("Cliente", "Reservas")"
               class="rs-btn-muted ajax-nav d-inline-flex align-items-center gap-2">
                <span>Continuar</span>
                <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    }
}

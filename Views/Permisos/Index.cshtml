@model IEnumerable<PIOGHOASIS.Models.ViewModels.RolPermisosRowVM>
@{
    Layout = null;
}

<style>
    .perm-ui {
        position: relative;
        min-height: calc(100vh - var(--header-h));
        padding: 30px;
        background: linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,.30)),url('/img/dashboard/FondoDashboard.jpg') center/cover no-repeat #000
    }

    .perm-tt {
        font-weight: 800;
        color: #1f2a37
    }

    .btn-nuevo {
        background: #f0a100;
        border: none;
        color: #222;
        font-weight: 800;
        box-shadow: 0 10px 22px rgba(240,161,0,.35)
    }

        .btn-nuevo:hover {
            background: #db9400
        }

    .perm-ui thead th {
        background: #f3c259;
        color: #222;
        border-bottom: 2px solid #d7a536
    }

    .pill-list {
        margin: 0;
        padding-left: 1.25rem
    }
</style>

<div class="perm-ui">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="perm-tt mb-0">Permisos por Rol</h3>
        @* <a class="btn btn-nuevo ajax-nav" href="/Permisos/Create" data-url="/Permisos/Create">
            <i class="bi bi-plus-circle me-1"></i> Asignar Permisos
        </a> *@
    </div>

    <div class="card p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:240px">Rol</th>
                        <th>Módulos Permitidos</th>
                        <th style="width:120px" class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.RolNombre</td>
                            <td>
                                <ul class="pill-list">
                                    @foreach (var m in r.ModulosPermitidos)
                                    {
                                        <li>@m</li>
                                    }
                                </ul>
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-outline-primary ajax-nav" href="/Permisos/Edit/@r.RolID" data-url="/Permisos/Edit/@r.RolID" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



